esignPLUS Video Hub"},da:{options:"Options",grade_level:"Grade level",output_language:"Output Language",grade_summary:"Grade {n}",options_saved:"Saved for your next suggestion",close:"Close",cancel:"Cancel",tryAgain:"Try Again",accept:"Accept"},si:(0,p.A)({check_text:"Check",check_answers:"Check Answers",shuffle_text:"Shuffle",flip_text:"Flip Sides",solution_text:"Solution",reset_text:"Reset",try_again_text:"Try Again",a11y_check_score:"Score: {c} of {t}.",a11y_reset_announcement:"Activity reset.",a11y_kbd_suffix_tab_to_check:" Tab to Check when finished.",start_belt_region:"Activity instructions",start_activity_instructions_reminder:"You can access these instructions later from the Instructions button in the activity controls.",a11y_instructions:"Instructions",controls_instructions:"Complete the learning activity. Your participation is not saved to the Canvas gradebook.",keyboard_controls_info:"For information about keyboard controls, please visit {0}the Interactive Keyboard Controls page{1}.",timer_label:"Time",score_label:"Score",attempts_label:"Attempts",start_activity:"Start Activity",a11y_score_attempts_one:" in {n} attempt",a11y_score_attempts_other:" in {n} attempts",a11y_time_minute_one:"{n} minute",a11y_time_minute_other:"{n} minutes",a11y_time_second_one:"{n} second",a11y_time_second_other:"{n} seconds",a11y_time_join:"{a} and {b}",a11y_score_time_wrap:" in {time}",a11y_flip_card:"Flip Card",a11y_flip_to_front:"Flip to front",a11y_flip_to_back:"Flip to back",a11y_now_showing_front:"Now showing the front",a11y_now_showing_back:"Now showing the back",a11y_front_card_visible:"Front card is now visible.",a11y_select_to_flip:"Select to flip the card",front_card:"Front Card",back_card:"Back Card",a11y_open_expander:"Open Expander",a11y_close_expander:"Close Expander",expand_all_panels:"Expand All Panels",collapse_all_panels:"Collapse All Panels",a11y_tabs_group:"Tabs Group",previous_tab:"Previous Tab",next_tab:"Next Tab",read_aloud_enable:"Expand content for listening",read_aloud_disable:"Exit listening view",read_aloud_enable_tooltip:"Shows all collapsed sections, tabs, and pop-up content on this page so text-to-speech tools can read the full lesson. Use this before clicking Listen.",read_aloud_disable_tooltip:"Returns the page to its normal interactive layout.",read_aloud_interactive_skip:"This section contains an interactive activity. Use the on-screen controls to complete it, or ask your instructor for an alternative format.",dialog_box:"Dialog Box",a11y_close:"Close",input_personal_notice:"This input box is for personal use only. The content is not saved or submitted.",a11y_enter_your_answer:"Enter your answer",a11y_answer_correct:"Your answer is correct",a11y_answer_incorrect:"Your answer is incorrect",notice_markup:"HTML tags cannot be submitted. Type your response as plain text.",a11y_not_submitted:"Response not submitted. {reason}",a11y_toggle_fullscreen_esc:"Toggle Fullscreen (ESC will also close)",a11y_toggle_fullscreen:"Toggle Fullscreen",exit_fullscreen:"Exit full screen (ESC)",fullscreen:"Full screen",language_accents_named:"{name} Accents",a11y_windows:"Windows",a11y_mac:"Mac"},{controls_rounded:"Adjust the roundedness of the interactive element and controls",square:"Square",rounded:"Rounded",controls_outline:"Adjust the outline for the interactive element and controls",controls_outline_heading:"Controls Outline",controls_corners:"Controls Corners",none:"None",outline:"Outline",hide_solution_button:"Hide the solution from students",hide_controls_button:"Hide the controls from students",hide_timer_button:"Hide the timer from students",hide_next:'Hide "Next" until all interactives completed',hide_next_message:"Complete all interactive activities to proceed",hide_next_notice:'The "Hide Next" settings will apply for all student interactives and quick checks on the page.',hide_next_mobile_notice:"Hiding the Next button is not supported on the Canvas mobile app.",feedback_correct:"Show feedback when 100% correct",feedback_incorrect:"Show feedback when incorrect",accept_misspellings:"Accept minor misspellings",disable_case:"Enable case-sensitive answers",disable_data_tracking:"Disable data tracking for this interactive",title:"Data Tracking Title",tracking_input_check_only:"Data tracking is only available for Flashcards with Input Check applied.",view_data:"View Data",no_responses_yet:"No student responses were found for this interactive yet.",feedback_correct_placeholder:"Feedback when 100% correct.",feedback_incorrect_placeholder:"Feedback when incorrect."}),account_settings:{title:"Account Settings",group_modified_count:"{n}/{total} modified",group_settings_count_one:"{n} setting",group_settings_count:"{n} settings",save_notice:"Changes to Account Settings do not take effect until this page is saved.  Any open browser sessions must refresh to load the changes.",search_label:"Search settings",search_placeholder:"Search settings",only_modified:"Show only modified settings",expand_all:"Expand all",collapse_all:"Collapse all",total_modified_count:"{n} of {total} settings modified",no_results:"No settings match your search.",no_default_theme:"No default theme",activate_setting:"Modify this setting",if_not_set:"If not set on this page:",about_setting:"About this setting",keep_current:"Keep current behavior",unchecked:"Unchecked",checked:"Checked",source_install_badge:"DesignPLUS install config",source_default_badge:"DesignPLUS default",no_tools_selected:"No tools selected",nothing_set:"Nothing set",remove_tool:"Remove {name}",add_tool:"Add a tool",add_tool_placeholder:"Search or browse tools to add",browse_tools:"Show all tools",matching_tools:"Matching tools",no_matching_tools:"No matching tools",group_access:"Access and Identity",group_sidebar:"Sidebar and Tools",group_styling:"Styling",group_qsw:"QuickStart Wizard",group_dtw:"Transformation Wizard",group_da:"AI Design Assistant",group_course:"Course Sidebar",group_student:"Student Experience",field_primary_display_name_title:"Primary Content Identifier",field_primary_display_name_label:"Set Primary Customizations content label",field_primary_display_name_description:'<p class="card-text">When checked, this label appears on source panels and tool titles that refer to the Primary Customizations course.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#dpPanel1" class="card-link">Learn more about customizations content identifiers</a>',field_extended_display_name_title:"Extended Content Identifier",field_extended_display_name_label:"Set Extended Customizations content label",field_extended_display_name_description:'<p class="card-text">When checked, this label appears on source panels and tool titles that refer to the Extended Customizations course.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#dpPanel1" class="card-link">Learn more about customizations content identifiers</a>',field_account_settings_admin_only_title:"Account Settings: Super Admin Access Only",field_account_settings_admin_only_label:"Only allow root admins to edit DesignPLUS account settings",field_account_settings_admin_only_description:'<p class="card-text">When checked, only users with root admin roles can edit Account Settings with this tool.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#dpPanel4" class="card-link">Learn more about limiting Account Settings access</a>',field_account_settings_admin_only_checked_text:"Only root admins can change Account Settings",field_account_settings_admin_only_unchecked_text:"Anyone who can edit this page can change Account Settings",field_hide_button_title:"Hide Launch Button",field_hide_button_label:"Hide Launch Button by Default",field_hide_button_description:'<p class="card-text">When checked, only users who know the <span class="badge bg-dark">Alt/Option+Shift+D</span> or <span class="badge bg-dark">Ctrl+1</span> keyboard shortcut keys will be able to use the DesignPLUS Sidebar.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#hideLaunch" class="card-link">Learn more about hiding the launch button</a>',field_hide_button_checked_text:"The sidebar launch button is hidden; users open the sidebar with a keyboard shortcut",field_hide_button_unchecked_text:"The sidebar launch button is shown",field_tool_group_title:"Account Tools Group",field_tool_group_label:"Tools to display in account tools group",field_tool_group_description:'<p class="card-text">Selected tools will appear in their own category in the <strong>Add</strong> panel of the sidebar to highlight account favorite tools.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#accountToolsGroup" class="card-link">Learn more about the account tools group</a>',field_excluded_modules_title:"Disabled Tools",field_excluded_modules_label:"Disabled Tools",field_excluded_modules_description:'<p class="card-text">Selected tools will be removed from the <strong>Add</strong> panel of the sidebar and will not be available to users.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#disableTools" class="card-link">Learn more about disabling tools</a>',field_default_theme_title:"Default Theme",field_default_theme_label:"Default Theme",field_default_theme_description:'<p class="card-text">The selected theme will be automatically applied when a user initially adds a theme to the page with the sidebar.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#setDefaultTheme" class="card-link">Learn more about using Themes</a>',field_brand_only_title:"Branding Colors Only",field_brand_only_label:"Limit color options to branding colors only",field_brand_only_description:'<p class="card-text">When checked, only the branding color options will display in color pickers for basic tools.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#hideMiscSwatches" class="card-link">Learn more about default color swatches</a>',field_brand_only_checked_text:"Color pickers show only your branding colors",field_brand_only_unchecked_text:"Color pickers show all color options",field_sortable_rubrics_title:"Sortable Rubrics",field_sortable_rubrics_label:"Enable Sortable Rubrics",field_sortable_rubrics_description:'<p class="card-text">When checked, allow legacy rubric editors to reorder rubric criteria.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#sortableRubrics" class="card-link">Learn more about sortable rubrics</a>',field_sortable_rubrics_checked_text:"Teachers using the legacy rubric editor can reorder rubric criteria",field_sortable_rubrics_unchecked_text:"Teachers using the legacy rubric editor can't reorder rubric criteria",field_student_cards_title:"Student Cards",field_student_cards_label:"Show student cards in the People page",field_student_cards_description:'<p class="card-text">When checked, provide an alternative view of the People page in each Canvas course that enlarges the student images.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#studentCards" class="card-link">Learn more about student cards</a>',field_student_cards_checked_text:"The People page offers a student cards view with larger photos",field_student_cards_unchecked_text:"The People page shows the standard Canvas list only",field_ally_relocate_title:"Ally Dropdown Relocation",field_ally_relocate_label:"Relocate Ally alternate formats dropdown",field_ally_relocate_description:'<p class="card-text">For institutions who use Blackboard Ally, if checked, this setting will move the Ally alternate formats dropdown from the content title to the top left corner of the content so that the native Canvas title can be hidden when a Banner Title is present.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#allyRelocate" class="card-link">Learn more about Ally dropdown relocation</a>',field_ally_relocate_checked_text:"The Ally alternative formats menu moves to the top-left corner of the content",field_ally_relocate_unchecked_text:"The Ally alternative formats menu stays next to the page title",field_hide_fonts_title:"Hide Font Style Options",field_hide_fonts_label:"Hide Google font style options in the Sidebar",field_hide_fonts_description:'<p class="card-text">When checked, Cidi Labs offers several imported Google Fonts for users to style text.  Enabling this setting will remove these font options from the Sidebar tools so that users working in the account/sub-account associated with this [Account Settings] page cannot change font styles with DesignPLUS.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#fontStyles" class="card-link">Learn more about limiting font styles</a>',field_hide_fonts_checked_text:"The sidebar doesn't offer Google font styles",field_hide_fonts_unchecked_text:"The sidebar offers Google font styles",field_enable_dtw_title:"Enable Transformation Wizard",field_enable_dtw_label:"Show the Transformation Wizard button to all users",field_enable_dtw_description:'<p class="card-text">Use the Transformation Wizard button to quickly add DesignPLUS styles to existing content in the editor.  When checked, this setting will make the Transformation Wizard button available for users working in the account/sub-account associated with this [Account Settings] page, regardless of whether the sidebar launch button is hidden or not.</p>\n                <p><strong>The Transformation Wizard is currently in <mark class="badge bg-success">BETA</mark> and is only available for <a href="https://cidilabs.instructure.com/courses/6630/pages/user-settings/#dpPanel9" target="_blank">users who have enabled beta tools.</a></strong></p>\n                <p><a target="_blank" href="https://support.cidilabs.com/knowledgebase/how-is-cidi-labs-approaching-the-use-of-ai" class="card-link">Learn more about AI in DesignPLUS</a></p>    \n                <p><a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/transformation-wizard" class="card-link">Learn more about the Transformation Wizard</a></p>',field_enable_dtw_checked_text:"The Transformation Wizard button is shown to users who have turned on beta tools",field_enable_dtw_unchecked_text:"The Transformation Wizard button isn't shown",field_disable_dtw_ai_title:"Disable AI in Transformation Wizard",field_disable_dtw_ai_label:"Hide AI features in Transformation Wizard",field_disable_dtw_ai_description:'<p class="card-text">The Transformation Wizard uses AI features to identify and generate headings, icons, and image alt text.  When checked, this setting will disable these AI features and degrade the Transformation Wizard experience for users working in the account/sub-account associated with this [Account Settings] page. This setting does not affect the AI-powered Design Assistant.</p>\n                <p><strong>The Transformation Wizard is currently in <mark class="badge bg-success">BETA</mark> and is only available for <a href="https://cidilabs.instructure.com/courses/6630/pages/user-settings/#dpPanel9" target="_blank">users who have enabled beta tools.</a></strong></p>\n                <p><a target="_blank" href="https://support.cidilabs.com/knowledgebase/how-is-cidi-labs-approaching-the-use-of-ai" class="card-link">Learn more about AI in DesignPLUS</a></p>    \n                <p><a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/transformation-wizard" class="card-link">Learn more about the Transformation Wizard</a></p>',field_disable_dtw_ai_checked_text:"The Transformation Wizard doesn't use AI (no suggested headings, icons, or alt text)",field_disable_dtw_ai_unchecked_text:"The Transformation Wizard uses AI to suggest headings, icons, and alt text",field_enable_wizard_title:"Enable QuickStart Wizard",field_enable_wizard_label:"Enable the QuickStart Wizard tool for all users",field_enable_wizard_description:'<p class="card-text">Use the QuickStart Wizard tool to quickly add DesignPLUS content to the editor.  When checked, this setting will make the QuickStart Wizard button available for users working in the account/sub-account associated with this [Account Settings] page, regardless of whether the sidebar launch button is hidden or not.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/quickstart-wizard" class="card-link">Learn more about the DesignPLUS QuickStart Wizard</a>',field_enable_wizard_checked_text:"The QuickStart Wizard button is shown to all users, even when the launch button is hidden",field_enable_wizard_unchecked_text:"The QuickStart Wizard button isn't shown",field_hide_qsw_title:"Hide QuickStart Wizard button by default",field_hide_qsw_label:"Hide the QuickStart Wizard button by default",field_hide_qsw_description:'<p class="card-text">When checked, this setting will hide the QuickStart Wizard button for users working in the account/sub-account associated with this [Account Settings] page. Users can still open the QuickStart Wizard with <span class="badge bg-dark">Alt/Option+Shift+Q</span>, and may opt to show the button again from a checkbox in the wizard.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/quickstart-wizard" class="card-link">Learn more about the DesignPLUS QuickStart Wizard</a>',field_hide_qsw_checked_text:'The QuickStart Wizard button is hidden; users open it with <span class="badge bg-dark">Alt/Option+Shift+Q</span>',field_hide_qsw_unchecked_text:"The QuickStart Wizard button is shown",field_hide_dtw_title:"Hide Transformation Wizard button by default",field_hide_dtw_label:"Hide the Transformation Wizard button by default",field_hide_dtw_description:'<p class="card-text">When checked, this setting will hide the Transformation Wizard button for users working in the account/sub-account associated with this [Account Settings] page. Users can still open the Transformation Wizard with <span class="badge bg-dark">Alt/Option+Shift+Q</span>, and may opt to show the button again from a checkbox in the wizard.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/transformation-wizard" class="card-link">Learn more about the DesignPLUS Transformation Wizard</a>',field_hide_dtw_checked_text:'The Transformation Wizard button is hidden; users open it with <span class="badge bg-dark">Alt/Option+Shift+Q</span>',field_hide_dtw_unchecked_text:"The Transformation Wizard button is shown",field_customize_wizard_message_title:"Add Custom QuickStart Wizard Message",field_customize_wizard_message_label:"Add a custom message to the bottom of the QuickStart Wizard welcome",field_customize_wizard_message_description:'<p class="card-text">When checked, this text appears at the bottom of the QuickStart Wizard welcome message.  Do not add HTML to this text area.  If you wish to completely replace the default QuickStart Wizard welcome message, create and publish a page titled [QuickStart Wizard Welcome] in this customizations course.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/quickstart-wizard" class="card-link">Learn more about the DesignPLUS QuickStart Wizard</a>',field_hide_wizard_imports_title:"Hide Cidi Labs Content (QuickStart Wizard)",field_hide_wizard_imports_label:"Hide Cidi Labs templates and blocks in the QuickStart Wizard",field_hide_wizard_imports_description:'<p class="card-text">Cidi Labs creates and hosts template pages and content blocks that are automatically imported into the QuickStart Wizard.  When checked, this setting will prevent these resources from being imported into the QuickStart Wizard for users working in the account/sub-account associated with this [Account Settings] page.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/quickstart-wizard" class="card-link">Learn more about the DesignPLUS QuickStart Wizard</a>',field_hide_wizard_imports_checked_text:"The QuickStart Wizard doesn't include Cidi Labs templates and blocks",field_hide_wizard_imports_unchecked_text:"The QuickStart Wizard includes Cidi Labs templates and blocks",field_hide_imports_title:"Hide Cidi Labs Content (Sidebar)",field_hide_imports_label:"Hide Cidi Labs content in the Sidebar",field_hide_imports_description:'<p class="card-text">Cidi Labs creates and hosts customizations content such as content blocks that are automatically imported into the Sidebar.  When checked, this setting will prevent these customizations from being imported into the Sidebar tools for users working in the account/sub-account associated with this [Account Settings] page.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#cidilabsContent" class="card-link">Learn more about Cidi Labs customizations content</a>',field_hide_imports_checked_text:"The sidebar doesn't include Cidi Labs content",field_hide_imports_unchecked_text:"The sidebar includes Cidi Labs content",field_course_sidebar_disabled_title:"Disable Course Sidebar",field_course_sidebar_disabled_label:"Disable access to the Course Sidebar in the Settings page",field_course_sidebar_disabled_description:'<p class="card-text">The Course Sidebar gives user access to special tools that can make course wide changes such as the Course Upgrade Tool.  When checked, this setting will disable access to the Course Sidebar so that users working in the account/sub-account associated with this [Account Settings] page cannot use these special tools.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/6630/pages/course-sidebar" class="card-link">Learn more about the course sidebar</a>',field_course_sidebar_disabled_checked_text:"The Course Sidebar (including the Course Upgrade tool) is turned off",field_course_sidebar_disabled_unchecked_text:"The Course Sidebar is available on the course Settings page",field_enable_da_title:"Enable Design Assistant",field_enable_da_label:"Show the AI-powered Design Assistant panel and features",field_enable_da_description:'<p class="card-text">Use the AI-powered Design Assistant to generate content for tools such as Flashcards or Quick Checks.  When checked, this setting will show the Design Assistant panel and other AI-powered sidebar features (such as Image Alt Text Suggestions) for users working in the account/sub-account associated with this [Account Settings] page.</p>\n        <p><strong>The Design Assistant panel is currently in <mark class="badge bg-success">BETA</mark> and is only available for <a href="https://cidilabs.instructure.com/courses/6630/pages/user-settings/#dpPanel9" target="_blank">users who have enabled beta tools.</a></strong></p>\n            <a target="_blank" href="https://support.cidilabs.com/knowledgebase/how-is-cidi-labs-approaching-the-use-of-ai" class="card-link">Learn more about AI in DesignPLUS</a>',field_enable_da_checked_text:"The Design Assistant and other AI features are shown to users who have turned on beta tools",field_enable_da_unchecked_text:"The Design Assistant and other AI features are turned off",field_disable_si_title:"Disable Interactive Data Tracking",field_disable_si_label:"Disable data tracking for all interactive exercises",field_disable_si_description:'<p class="card-text">By default, interactive exercises such as Fill-in-the-Blank and Sort Items track anonymous data when students submit their answers.  \n        When checked, this setting will disable data collection for all interactive exercises for users working in the account/sub-account associated with this [Account Settings] page.</p>\n            <a target="_blank" href="https://cidilabs.instructure.com/courses/7037/pages/account-settings-instructions#disableSI" class="card-link">Learn more about disabling interactive data</a>',field_disable_si_checked_text:"Interactive exercises don't collect answer data, and the Interactive Data tool is hidden",field_disable_si_unchecked_text:"Interactive exercises collect anonymous answer data, shown in the Interactive Data tool",field_enable_read_aloud_title:"Enable Read Aloud View",field_enable_read_aloud_label:"Show a student toggle to expand hidden content for text-to-speech (ReadSpeaker)",field_enable_read_aloud_description:'<p class="card-text">When enabled, content that includes interactive DesignPLUS features will display a button to show hidden content (e.g. accordions, tabs, popups) so text-to-speech tools like ReadSpeaker can read the full content. Interactive exercises receive a spoken note instead of being flattened.</p>\n        <p class="card-text">Enable this setting for institutions using ReadSpeaker or similar text-to-speech tools that skip hidden content.</p>',field_enable_read_aloud_checked_text:"Students see a Read Aloud View button that expands hidden content for text-to-speech",field_enable_read_aloud_unchecked_text:"Students don't see a Read Aloud View button"},image:{title:"Image",titleV2:"Image V2",titleCaption:"Image & Caption",titleCaptionV2:"Image & Caption V2",altTextLabel:"Alt Text",altTextPlaceholder:"(Describe the image)",altTextPopup:"Alternative text provides information for an image if a user for some reason cannot view it (because of slow connection, an error in the src attribute, or if the user uses a screen reader).",decorativeLabel:"Decorative",folderTitleCourse:"All Course Images",folderTitleUser:"All User Images",folderTitleShared:"All Shared Images",folderTitleExtended:"All Extended Images",folderTitlePrimary:"All Primary Images",folderTitleNamed:"All {label} Images",foldersFilters:"Folders/Filters",allFolders:"-- All Folders --",copyDestinationFolder:"Copy Destination Folder",chooseDestinationFolder:"Choose Destination Folder",addLink:"Add Link",linkDisableLink:"Image already has a link",linkDisablePopup:"Cannot add link to a popup image",disabled:"Disabled",imageSearch:"Image Search",searchFileName:"Search File Name",altTextWarning:"Please set alt text or mark as decorative.",suggestAltTextNotInCourse:"This image doesn't live in the course yet. Please save the page and try again.",copyToCourse:"Copy to Course",copyAnyway:"Copy Anyway",cancel:"Cancel",copyNeeded:"Copy this image to your course so all students can see it.",copySourceHint:"You’re browsing images from another course. They aren’t available to students here until copied.",copySourceHintSr:"After you select an image, copy options will appear below the image list.",copyDuplicateDesc:"A file with the same name already exists in this course. Copying will rename the new file.",sameNameFound:"An image with the same filename was found in your course. If you choose to copy the selected image to your course anyway, it will be renamed.",viewExistingFile:"View Existing File",linkOpensNewTab:"Link opens in a new tab",copySuccess:"The image copied successfully.",copyFailed:"The image failed to copy.",captionLabel:"Caption",captionPlaceholder:"(Caption below the image)",captionPopup:"A caption does not replace the need for appropriate alt text.",placeholderAlt:"image placeholder",placeholderCaption:"Caption text",refreshImageList:"Refresh Image List",changeImage:"Change Image",workflowSelectImage:"Choose an image from your computer",workflowDropHelp:"Choose a file, drag and drop an image here, or paste an image from the clipboard.",workflowPublicUrl:"Public image URL",workflowFilename:"File name",workflowDestination:"Destination folder",workflowRootFolder:"Course files (root)",workflowOptimize:"Optimize for web (maximum width 1100px)",workflowOptimizeHelp:"This reduces the uploaded file dimensions, but does not change the image display width in the editor.",workflowLargeImageHeading:"This image is larger than the content width",workflowLargeImageBody:"Optimize for web to shrink the file without changing how it displays in the page.",workflowLargeImageSavingsAt:"at {0} × {1} pixels",workflowOptimizeOverwrite:"Overwrite the existing course file",workflowOptimizeOverwriteHelp:"Overwriting changes the image anywhere this Canvas file is used.",workflowOptimizeSaveAsNewHelp:"Leave this unchecked to upload a new optimized file and update only this editor image.",workflowUploadSaveAsNewHelp:"Leave this unchecked to upload a new file and update only this editor image.",workflowOptimizeForWeb:"Optimize for web",workflowOptimizeIgnore:"Don’t optimize this image",workflowOptimizeIgnoreHelp:"Hide this recommendation for this image. You can still use Edit Image to optimize in the future.",workflowOptimizing:"Optimizing image…",workflowOptimizeSuccess:"Image optimized: {0} → {1} at {2} × {3} pixels.",workflowOptimizeFailed:"The image could not be optimized.",workflowUploadEmbed:"Upload and embed image",workflowMoreOptions:"More options",workflowFileOptions:"File options",workflowClipboardName:"clipboard-image.png",workflowPasteAccepted:"Clipboard image selected.",workflowLoadingFolders:"Loading course folders…",workflowFoldersFailed:"Course folders could not be loaded. The root folder will be used.",workflowSelectedFile:"Selected: {0} ({1})",workflowSelectedUrl:"Public URL: {0}",workflowSelectedImage:"Selected image: {0}",workflowSelectedHeading:"Selected image",workflowCurrentEditorImage:"Current editor image: {0}",workflowPendingCopy:"Copy this image into the course to finish.",workflowPendingUpload:"This image i