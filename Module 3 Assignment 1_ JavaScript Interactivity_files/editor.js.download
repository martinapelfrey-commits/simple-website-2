istOl:{descriptions:["Create ordered (numbered) list of items","Give step by step instructions that follow a sequence"],links:[{text:"User Guide: Ordered and Unordered Lists",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/ordered-and-unordered-lists"}]},listUl:{descriptions:["Create unordered (bulleted) list of items"],links:[{text:"User Guide: Ordered and Unordered Lists",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/ordered-and-unordered-lists"}]},listNav:{descriptions:["Create a navigation bar with hyperlinks","Add a menu to assist students in navigating the course"],links:[{text:"User Guide: Link Lists",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/link-lists"}]},matchItems:{descriptions:["Create a memory game or item matching activity for students","Check student answers against the original pairs of items"],links:[{text:"User Guide: Match Items",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/match-items"}]},mathChecker:{descriptions:["Review, add, or update alt text for equation images on a page","Get alt text suggestions for equation images","Make equation images accessible to students using assistive technology"],links:[{text:"User Guide: Math Checker",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/math-checker"}]},mediaList:{descriptions:["Create a list of media elements"],links:[{text:"User Guide: Media List",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/media-list"}]},modal:{descriptions:["Incorporate a modal window or box (pop-up)","Hide content from students until they click a trigger to reveal pop-up"],links:[{text:"User Guide: Dialog Boxes",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/dialog-boxes"}]},moduleList:{descriptions:["Add a hyperlinked list of course modules","Allow students to view and navigate module contents on any page","Provide a course overview and student progress on a page"],links:[{text:"User Guide: Module Lists",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/module-lists"}]},navigation:{descriptions:["Provide a variety of navigation options to students"],links:[{text:"User Guide: Navigation",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/navigation"}]},objective:{descriptions:["Insert prewritten program or course objectives, competencies, or other standards","Show the alignment of course contents with intended outcomes to students, accreditation agencies, and other stakeholders","Write new objectives based on Bloom's Taxonomy verbs","Share saved objectives with other users"],links:[{text:"User Guide: Objectives",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/objectives"}]},orderItems:{descriptions:["Create a list of items that can be ordered by students","Provide a way for students to order items in a list","Check student answers against the original order of items"],links:[{text:"User Guide: Order Items",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/order-items"}]},policy:{descriptions:["Insert content that stays up-to-date with a master copy","Add policies that can be maintained and updated by the institution"],links:[{text:"User Guide: Policies",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/policies"}]},popover:{descriptions:["Add pop-up info bubbles that appear when a viewer activates the text trigger with a click, tap, or enter key"],links:[{text:"User Guide: Popovers",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/popovers"}]},previewContent:{descriptions:["Preview page content as it would appear in different screen sizes","Ensure content is optimized for students using the mobile app"],links:[{text:"User Guide: Preview Content",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/preview-content"}]},progressIndicator:{descriptions:["Add an indicator bar that shows the user's position within a module","Provide students with enhanced intramodule navigation"],links:[{text:"User Guide: Progress Indicators",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/progress-indicators"}]},questions:{descriptions:["Add pre-built question stems to content","Share saved questions with other users"],links:[{text:"User Guide: Questions",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/questions"}]},quickCheck:{descriptions:["Add an ungraded quiz question to a page to check comprehension","Integrate informal self-assessment with instant feedback for students"],links:[{text:"User Guide: Quick Checks",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/quick-checks"}]},quote:{descriptions:["Add a styled quote to a page"],links:[{text:"User Guide: Quote",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/quote"}]},readability:{descriptions:["Get a readability score and grade level for the content","Convert page content to a different readability grade level","<strong>New Dale Chall</strong> - focuses on word familiarity (using a list of 3,000 common words) and sentence length","<strong>Flesch Kincaid</strong> - focuses on average syllable count per word and average sentence length","<strong>SMOG</strong> - focuses on sentence length and polysyllabic word count"],links:[{text:"User Guide: Readability",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/readability"}]},readTime:{descriptions:["Provide an estimated read time for page content in minutes based on words per minute (wpm) speed","Insert manual read time estimate"],links:[{text:"User Guide: Read Time",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/read-time"}]},release_note:{descriptions:["View monthly release notes and product updates for DesignPLUS"],links:[{text:"User Guide: Viewing Release Notes",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/viewing-release-notes"}]},poll:{descriptions:["Ask students an ungraded question with no correct answer","Optionally show the class results back to students once at least five have responded"],links:[{text:"User Guide: Polls",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/polls"}]},selectAll:{descriptions:["Add an ungraded multiple answer activity to a page to check comprehension","Integrate informal self-assessment with instant feedback for students"],links:[{text:"User Guide: Select All",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/select-all"}]},settings:{descriptions:["Adjust personal user settings for DesignPLUS"],links:[{text:"User Guide: User Settings",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/user-settings"}]},shortcuts:{descriptions:["Add shortcut buttons for commonly used course functions"],links:[{text:"User Guide: Content Shortcuts",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/content-shortcuts"}]},snippet:{descriptions:["Add preconfigured chunks of HTML to content","Share saved HTML code with other users"],links:[{text:"User Guide: Snippets",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/snippets"}]},studentInteractiveSort:{descriptions:["Add an ungraded sorting activity to a page to check comprehension","Integrate informal self-assessment with instant feedback for students"],links:[{text:"User Guide: Sort Items",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/sort-items"}]},styleEditor:{descriptions:["Build and save custom styles for content elements","Adjust existing custom styles"],links:[{text:"User Guide: Style Editor",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/style-editor"}]},styleIframes:{descriptions:["Review and style all the iframe elements on the page in one place"],links:[{text:"User Guide: Style Iframes",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/style-iframes"}]},styleStudio:{descriptions:["Apply saved custom styles","Share saved styles with other users","Remove, rename, or edit saved styles"],links:[{text:"User Guide: Quick Style Manager",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/style-studio"}]},syllabus_nav:{descriptions:["Create a fixed menu on the right side of the page","Build a menu of links to page headings, items from a single module, or all items from all modules","Allow users to quickly navigate the contents of the page, module, or course regardless of their scroll position"],links:[{text:"User Guide: Side Navigation",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/page-navigation"}]},table:{descriptions:["Build and style tables in content","Convert tables to columns"],links:[{text:"User Guide: Tables",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/tables"}]},tableChecker:{descriptions:["Check for table headers","Adjust table header direction"],links:[{text:"User Guide: Table Checker",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/table-checker"}]},tabs:{descriptions:["Create a tab widget in which one panel can open at a time","Style tabs in content","Create quick references like FAQ or resources"],links:[{text:"User Guide: Accordions, Expanders, and Tabs",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/accordions-expanders-and-tabs"}]},templateContent:{descriptions:["Add page templates to content from a variety of sources","Add tutorial templates or user guide templates to content"],links:[{text:"User Guide: Template Content",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/template-content"}]},text:{descriptions:["Add highlight styles to selected text","Emphasize important content in line for students"],links:[{text:"User Guide: Text Highlights",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/text-highlights"}]},themes:{descriptions:["Apply theme styling to pages","Manage the banner title, banner image, and navigation block elements"],links:[{text:"User Guide: Themes",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/themes"}]},tooltip:{descriptions:["Add a hover tooltip to a trigger word or phrase"],links:[{text:"User Guide: Tooltips",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/tooltips"}]},tutorial:{descriptions:["View and complete DesignPLUS tutorials in the context of the page"],links:[{text:"User Guide: Help and Tutorials",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/help-and-tutorials-overview"}]},upgrade:{descriptions:["Update legacy DesignPLUS classes","Make page elements compatible with the new DesignPLUS Sidebar"],links:[{text:"User Guide: Upgrade",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/upgrade"},{text:"User Guide: Course Upgrade",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/course-upgrade"}]},userDetails:{descriptions:["Add and style user details blocks for teachers, TAs, and course designers","Quickly add contact information for students to reference"],links:[{text:"User Guide: User Details",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/user-details"}]},user_guides:{descriptions:["View DesignPLUS user guides for each tool"],links:[{text:"User Guide",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630"}]},uxListHeading:{descriptions:["Review page usability issues related to design, file access, and screen size"],links:[{text:"User Guide: Usability Tools",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/accessibility-and-usability-overview"}],page:!0},videos:{descriptions:["Watch Cidi Labs training videos for DesignPLUS"],links:[{text:"Cidi Labs Video Hub",isExternal:!0,url:"https://videos.cidilabs.com/"}]},walkthrough:{descriptions:["Launch step-by-step walkthroughs for DesignPLUS tools"],links:[{text:"User Guide: Help and Tutorials",isExternal:!0,url:"https://cidilabs.instructure.com/courses/6630/pages/help-and-tutorials-overview"}]}},footer:{intro:{find:"<p>You can view the new user intro video later in the Help/Tutorials section.</p>",new:'<p>New to Next Generation DesignPLUS? Watch the <a href="https://www.youtube.com/watch?v=M_lhbq2AUgI" class="newUserIntroLink" target="_blank">New User Intro video</a> for a tour of the interface!</p>',wttitle:"Begin Walkthrough"},dismiss:{temp:"Dismiss",perm:"Don't show this message again"},notifications_none_initial:"<p>You have 0 notifications.</p>",notifications_none_cleared:"<p>You have no pending notifications.</p>",notifications_toggle:"Notifications, {n}"},content_block:{arrange:"Arrange Content Blocks",alt_bg_colors_title:"Alternate content blocks background color",no_alt_bg_colors_title:"Remove alternating content block backgrounds",title:"Content Block",placeholderHeading:"Content Block Heading",placeholderContent:"Content",searchTitle:"Content Blocks",searchPlaceholder:"Search Blocks",removeEmptyTitle:"Remove Empty Elements",unwrapTitle:"Unwrap Content Block",addAboveTitle:"Add New Content Block Above",addBelowTitle:"Add New Content Block Below",headingTextTitle:"Heading Text",iconPickerLabel:"&nbsp; Icon Picker",blockHeading:"Block Heading",templateBehavior:"Template Behavior",reusableSR:"not reusable",reusableTitle:"This block has an ID attribute so can only be used once",notReusable:"(Not Reusable)",id_already_on_page:"A block with ID {id} already exists on this page.",duplicate_ids_in_content:"Duplicate ID(s) in block content already on this page: {ids}.",primaryBlock:"Primary Block",extendedBlock:"Extended Block",sharedBlock:"Shared Block",courseBlock:"Course Block",cidilabsBlock:"Cidi Labs Block",lockedForEditing:"Locked for Editing",lockedForEditingTitle:"This block is locked for editing",popupGallery:"Set images in this block as popup image gallery",popupDisableLink:"This Content Block contains an image inside a link",popupDisableImage:"This Content Block contains a popup image",advancedTitle:"Content Block Title",advancedCategory:"Content Block Category",advancedPanelNotice:"Advanced Panel is for [Content Blocks] customization pages only.",overwrite:"Overwrite",addAbove:"Add Above",addBelow:"Add Below",course:"This Course",shared:"Shared",extended:"Extended",primary:"Primary",cidilabs:"Cidi Labs",styleStudio:"Content Blocks Style Studio",noHeading:"No Heading",heading2:"Heading 2",heading3:"Heading 3",heading4:"Heading 4",heading5:"Heading 5",heading6:"Heading 6",walkthrough_1_title:"Content Block Walkthrough",walkthrough_1_intro:"You can use content blocks to group page elements into sections of content, quickly create page layout from block templates, and organize pages into manageable pieces to increase usability for students. ",walkthrough_2_title:"Add Block Buttons",walkthrough_2_intro:"You can use these buttons if you'd like to add new content blocks before or after the current content block.",walkthrough_3_title:"Arrange Content Blocks",walkthrough_3_intro:"Want to change the order of your content blocks?  This button is a shortcut to the Arrange Content tool.",walkthrough_4_title:"Unwrap Content Block",walkthrough_4_intro:"If you want to get rid of a content block but save the content inside, you can remove the content block container and convert the inner contents into regular text blocks.",walkthrough_5_title:"Remove Empty Elements",walkthrough_5_intro:"Got empty elements like paragraphs, list items, or links?  This button will quickly remove them all for you.",walkthrough_6_title:"Block Heading",walkthrough_6_intro:"This is where you can insert a title for the content block heading.",walkthrough_7_title:"Heading Levels",walkthrough_7_intro:"This is where you can choose the h2-h6 heading level for the content block heading.  And the circle-with-slash option removes the heading.",walkthrough_8_title:"Template Behavior",walkthrough_8_intro:"Select the default behavior for new template blocks: Overwrite the current block, add above the current block, or add below the current block.",walkthrough_9_title:"Filters",walkthrough_9_intro:"You can filter the available blocks by search term or by source.  Unchecking a source button removes any content blocks from that source.",walkthrough_10_title:"Template Blocks Panels",walkthrough_10_intro:"In these expanders, you can access any pre-designed templates for content blocks.",walkthrough_11_title:"Alternate Content Block Background Colors",walkthrough_11_intro:"In the Style panel, you can choose to alternate the background color of your content blocks, applying a light blue-gray background to every other content block. Check the <strong>Alternate content blocks background color</strong> checkbox to apply this style.",walkthrough_11_title_flat:"Remove Alternating Content Block Backgrounds",walkthrough_11_intro_flat:"With Flat Sections themes, content blocks already alternate background colors. Check the <strong>Remove alternating content block backgrounds</strong> checkbox to turn that off.",walkthrough_12_title:"Create Popup Image Gallery",walkthrough_12_intro:"You can also choose to create a popup image gallery on the saved page. Checking the <strong>Set images in this block as popup image gallery</strong> checkbox creates a carousel of enlarged images that users can scroll through sequentially.",walkthrough_13_title:"Content Block Title & Category",walkthrough_13_intro:"When using this tool on a [Content Blocks] customizations page, this Advanced section allows you to set or adjust the title and category of the block when it appears in the Content Block tool.",walkthrough_14_title:"Content Block Walkthrough Complete",walkthrough_14_intro:'This completes the Content Block tool walkthrough. For more information about the Content Block tool, visit the <a href="https://cidilabs.instructure.com/courses/6630/pages/content-blocks" target="_blank">Content Blocks tool User Guide article.</a> Happy course building!'},accordion:{accordionTitle:"Accordion",expanderTitle:"Expander",tabsTitle:"Tabs",DAHeadingText:"{toolState} Builder",inputPrompt:"Enter a topic or passage from which to create panels.",generateButtonLabel:"Generate",applyButtonLabel:"Add Sections",countLabel:"Number of panels",title:"Accordion",tabs_label:"Tabs Label",tabs_label_tooltip:"This label provides a topic/category/title for the tabs group that will be read by screen readers.",heading_size:"Use default heading font size for panels",basic_tab_outline:"Outline tabs with active color",off:"Off",bottom:"Bottom",top:"Top",next_prev_buttons:"Next/Previous Buttons",panel_height:"Panel Height (px)",panel_height_min:"75px minimum",px:"px",heading_text:"Heading Text",heading_padding:"Heading Padding",default_padding:"Default Padding",unknown_tool:"Unknown Tool",panels:"Panels",panel:"Panel",paste_embed_code:"Paste Embed Code",tabs_group:"Tabs Group",new_panel:"New Panel",set_as_active:"Set as active",set_as_inactive:"Set as inactive",panel_n:"Panel {n}",nested_panel_n:"Nested Panel {n}",panel_heading_default:"Panel Heading",panel_content_text:"{heading} Content.",content_default:"Content",accordion_plus_minus:"Accordion Plus/Minus",expander_plus_minus:"Expander Plus/Minus",basic_tabs:"Basic Tabs",underlined_tabs:"Underlined Tabs",pill_tabs:"Pill Tabs",button_tabs:"Button Tabs",pill_tabs_vertical:"Pill Tabs Vertical",pill_tabs_vertical_outlined:"Pill Tabs Vertical Outlined",button_tabs_vertical:"Button Tabs Vertical",no_style:"No Style",tab_controls:"Tab Controls",tab_width:"Tab Width",default:"Default",fill_screen_width:"Fill Screen Width",equal:"Equal",nested_panel_group:"Nested Panel Group",unwrap_panels:"Unwrap Panels",remove_expand_collapse_all:"Remove Expand/Collapse All Controls",add_active_dates:"Add active dates to panels (MM/DD/YYYY)",style_studio:"Accordion Style Studio",refineInputPlaceholder:"What would you like to change?",wt_intro_title:"Accordion Walkthrough",wt_intro_text:"Use this tool to create a vertical expanding widget in which one panel can open at a time.",wt_intro_title_expander:"Expander Walkthrough",wt_intro_text_expander:"Use this tool to create a vertical expanding widget in which all panels can be open at the same time.",wt_intro_title_tabs:"Tabs Walkthrough",wt_intro_text_tabs:"Use this tool to create a tab widget in which one panel can open at a time.",wt_content_title:"Content",wt_content_intro:"<p>In the <strong>Content</strong> panel, use the <strong>Panels</strong> field and <strong>Panel</strong> button to add panels, and choose the heading level of panel headings.</p>",wt_tabs_label_title:"Tabs Label",wt_tabs_label_intro:"<p>Use <strong>Tabs Label</strong> to give this tab group a topic or title that screen readers will announce.</p>",wt_panel_controls_title:"Individual Panel Controls",wt_panel_controls_intro:"<p>You can also rearrange panels, set a panel to be open or active by default, and update panel heading text as well as duplicate and remove panels.</p>",wt_style_title:"Style",wt_style_intro:"<p>In the <strong>Style</strong> panel, choose a panel style or type. Changing the panel type will require you to select the matching tool in the related tools area.</p>",wt_style_colors_title:"Panel Colors",wt_style_colors_intro:"<p>Use the <strong>Default</strong>, <strong>Active</strong>, and <strong>Hover</strong> color pickers to set the colors of panel headings.</p>",wt_style_heading_title:"Heading Text",wt_style_heading_intro:"<p>Use the <strong>Heading Text</strong> buttons to align the text in panel headings.</p>",wt_style_padding_title:"Heading Padding",wt_style_padding_intro:"<p>Use <strong>Heading Padding</strong> to change how much space appears around panel heading text.</p>",wt_style_tab_outline_title:"Outline Tabs",wt_style_tab_outline_intro:"<p>Check <strong>Outline tabs with active color</strong> to draw an outline around basic tabs using the active color.</p>",wt_style_tab_controls_title:"Tab Controls",wt_style_tab_controls_intro:"<p>Use <strong>Tab Controls</strong> to align the tab buttons.</p>",wt_style_tab_width_title:"Tab Width",wt_style_tab_width_intro:"<p>Use <strong>Tab Width</strong> to keep the default tab size, fill the screen width, or make tabs equal width.</p>",wt_style_next_prev_title:"Next/Previous Buttons",wt_style_next_prev_intro:"<p>Use <strong>Next/Previous Buttons</strong> to add navigation below or above the tabs, or turn those buttons off.</p>",wt_style_heading_size_title:"Heading Font Size",wt_style_heading_size_intro:"<p>Check <strong>Use default heading font size for panels</strong> to use the theme heading size instead of the panel style size.</p>",wt_advanced_title:"Advanced",wt_advanced_intro:"<p>Use <strong>Nested Panel Group</strong> to insert a new panel group in an existing panel. (Note: just because you <em>can</em> nest panels doesn't mean you <em>should.</em> Please use this feature within reason and be kind to your learners.)</p>",wt_unwrap_title:"Unwrap Panels",wt_unwrap_intro:"<p>Use <strong>Unwrap Panels</strong> to remove the panel container while keeping the headings and content on the page.</p>",wt_expander_controls_title:"Expand/Collapse All Controls",wt_expander_controls_intro:"<p>Check <strong>Remove Expand/Collapse All Controls</strong> to hide the Expand/Collapse All buttons on the saved page.</p>",wt_advanced_dates_title:"Active Dates",wt_advanced_dates_intro:"<p>Check <strong>Add active dates to panels</strong> to add start and end dates in the panel content. When the current date falls between those dates, the panel is displayed as active.</p>",wt_preview_title:"Preview",wt_preview_intro:"<p>Use the <strong>Preview</strong> panel to view an interactive preview of the rendered panels.</p>",wt_complete_title:"Accordion Walkthrough Complete",wt_complete_intro:'This completes the Accordion tool walkthrough. For more detailed information about using the Accordion tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/accordions-expanders-and-tabs" target="_blank">visit the Accordions, Expanders, & Tabs User Guide article.</a> Happy course building!',wt_complete_title_expander:"Expander Walkthrough Complete",wt_complete_intro_expander:'This completes the Expander tool walkthrough. For more detailed information about using the Expander tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/accordions-expanders-and-tabs" target="_blank">visit the Accordions, Expanders, & Tabs User Guide article.</a> Happy course building!',wt_complete_title_tabs:"Tabs Walkthrough Complete",wt_complete_intro_tabs:'This completes the Tabs tool walkthrough. For more detailed information about using the Tabs tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/accordions-expanders-and-tabs" target="_blank">visit the Accordions, Expanders, & Tabs User Guide article.</a> Happy course building!'},attributes:{title:"Attributes",desc_id:'<p>The <a href="https://www.w3schools.com/tags/att_id.asp" target="_blank">id attribute</a> specifies a unique id for an HTML element (the value must be unique within the HTML document).</p>',desc_class:'<p>The <a href="https://www.w3schools.com/tags/att_id.asp" target="_blank">class attribute</a> is mostly used to point to a class in a style sheet. However, it can also be used by a JavaScript to make changes to HTML elements with a specified class.</p>',desc_style:'<p>The <a href="https://www.w3schools.com/tags/att_id.asp" target="_blank">style attribute</a> specifies an inline style for an element.</p>\n                    <p>The style attribute will override any style set globally, e.g. styles specified in an external style sheet.',desc_title:'<p>The <a href="https://www.w3schools.com/tags/att_title.asp" target="_blank">title attribute</a> specifies extra information about an element.</p>\n                <p>The information is most often shown as a tooltip text when the mouse moves over the element.</p>',desc_abbr:'The <a href="https://www.w3schools.com/tags/att_th_abbr.asp" target="_blank">abbr attribute</a> specifies an abbreviated version of the content in a header cell',desc_allowfullscreen:'Allows the <a href="https://www.w3schools.com/tags/tag_iframe.asp" target="_blank">iframe</a> to activate fullscreen mode',desc_alt:'<p>The <a href="https://www.w3schools.com/tags/att_alt.asp" target="_blank">alt attribute</a> provides alternative information for an image if a user for some reason cannot view it \n                (because of slow connection, an error in the src attribute, or if the user uses a screen reader).</p>',desc_cite:'The <a href="https://www.w3schools.com/tags/att_cite.asp" target="_blank">cite attribute</a> specifies a URL to a document that explains the quote, or why the text was inserted/changed.',desc_colspan:'The <a href="https://www.w3schools.com/tags/att_colspan.asp" target="_blank">colspan attribute</a> defines the number of columns a table cell should span.',dir_option_ltr:"ltr (left-to-right)",dir_option_rtl:"rtl (right-to-left)",dir_option_auto:"auto",desc_dir:'The <a href="https://www.w3schools.com/tags/att_global_dir.asp" target="_blank">dir attribute</a> specifies the text direction of the element&lsquo;s content. (Left-to-right or Right-to-left)',desc_height:'The <a href="https://www.w3schools.com/tags/att_height.asp" target="_blank">height attribute</a> specifies the height of the element, in pixels.',desc_href:'The <a href="https://www.w3schools.com/tags/att_href.asp" target="_blank">href attribute</a> specifies the URL of the page the link goes to.',desc_lang:'The <a href="https://www.w3schools.com/tags/ref_language_codes.asp" target="_blank">lang attribute</a> can be used to declare the language of a Web page or a portion of a Web page. This is meant to assist search engines and browsers.',lang_placeholder:"-- select a language --",desc_muted:'When present, it specifies that the audio output of the <a href="https://www.w3schools.com/tags/att_audio_muted.asp" target="_blank">audio</a> or <a href="https://www.w3schools.com/tags/att_video_muted.asp" target="_blank">video</a> should be muted.',desc_name:'The <a href="https://www.w3schools.com/tags/att_name.asp" target="_blank">name attribute</a> functionality varies by element',desc_playsinline:'The <a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Element/video">playsinline attribute</a> indicates that the video is to be played "inline", that is within the element\'s playback area. Note that the absence of this attribute does not imply that the video will always be played in fullscreen.',desc_poster:'The <a href="https://www.w3schools.com/tags/att_video_poster.asp" target="_blank">poster attribute</a> specifies an image to be shown while the video is downloading, or until the user hits the play button. If this is not included, the first frame of the video will be used instead.',desc_rowspan:'The <a href="https://www.w3schools.com/tags/att_rowspan.asp" target="_blank">rowspan attribute</a> specifies the number of rows a cell should span.',scope_option_col:"col",scope_option_row:"row",scope_option_colgroup:"colgroup",scope_option_rowgroup:"rowgroup",desc_scope:'The <a href="https://www.w3schools.com/tags/att_th_scope.asp" target="_blank">scope attribute</a> specifies whether a header cell is a header for a column, row, or group of columns or rows.',scrolling_option_auto:"auto",scrolling_option_yes:"yes",scrolling_option_no:"no",desc_scrolling:'The <a href="https://www.geeksforgeeks.org/html-iframe-scrolling-attribute/" target="_blank">scrolling Attribute</a> is used to specify whether the scrollbar will be displayed or not in the &lt;iframe&gt; element.',desc_span:'The <a href="https://www.w3schools.com/tags/att_span.asp" target="_blank">span attribute</a> specifies the number of columns to span',desc_src:'The <a href="https://www.w3schools.com/tags/att_src.asp" target="_blank">src attribute</a> specifies the location (URL) of the external resource.',desc_start:'The <a href="https://www.w3schools.com/tags/att_start.asp" target="_blank">start attribute</a> specifies the start value of an ordered list',target_option_self:"_self (default)",target_option_blank:"_blank (new window or tab)",target_option_parent:"_parent (parent frame)",target_option_top:"_top (full body of the window)",desc_target:'The <a href="https://www.w3schools.com/tags/att_a_target.asp" target="_blank">target attribute</a> specifies the target for where to open the linked document',list_type_option_circle:"circle",list_type_option_disc:"disc",list_type_option_square:"square",list_type_option_armenian:"armenian",list_type_option_cjk_ideographic:"cjk-ideographic",list_type_option_decimal:"decimal",list_type_option_decimal_leading_zero:"decimal-leading-zero",list_type_option_georgian:"georgian",list_type_option_hebrew:"hebrew",list_type_option_hiragana:"hiragana",list_type_option_hiragana_iroha:"hiragana-iroha",list_type_option_katakana:"katakana",list_type_option_katakana_iroha:"katakana-iroha",list_type_option_lower_alpha:"lower-alpha",list_type_option_lower_greek:"lower-greek",list_type_option_lower_latin:"lower-latin",list_type_option_lower_roman:"lower-roman",list_type_option_upper_alpha:"upper-alpha",list_type_option_upper_latin:"upper-latin",list_type_option_upper_roman:"upper-roman",list_type_option_none:"none",list_type_option_inherit:"inherit",desc_type:'The <a href="https://www.w3schools.com/tags/att_ol_type.asp" target="_blank">type attribute</a> specifies the kind of marker to use in an ordered list (DesignPLUS uses CSS not type attribute)',desc_value:'The <a href="https://www.w3schools.com/tags/att_li_value.asp" target="_blank">value attribute</a> sets the value of an ordered list item. The following list items will increment from that number.',desc_width:'The <a href="https://www.w3schools.com/tags/att_width.asp" target="_blank">width attribute</a> specifies the width of the element, in pixels',walkthrough_title_overview:"Attributes Walkthrough",walkthrough_intro_overview:"<p>Use the Attributes tool to view, add, edit, or remove HTML attributes on the selected page element without opening the HTML source. Click a field label for more detail about that attribute.</p>",walkthrough_title_choose_element:"Choose an Element to Edit",walkthrough_intro_choose_element:"In the <strong>node list</strong>, you can select the element whose attributes you want to view or edit. Hover over a node to view its content type.",walkthrough_title_id:"id Attribute",walkthrough_intro_id:"<p>The <strong>id</strong> attribute specifies a unique id for the selected element. The value must be unique within the HTML document.</p>",walkthrough_title_class:"class Attribute",walkthrough_intro_class:"<p>The <strong>class</strong> attribute lists CSS classes for the selected element. Classes can also be used by JavaScript to target elements. This tool formats classes with one class per line in the textarea.</p>",walkthrough_title_style:"style Attribute",walkthrough_intro_style:"<p>The <strong>style</strong> attribute sets inline styles on the selected element. Inline styles override rules from a stylesheet. This tool formats declarations with one per line.</p>",walkthrough_title_title:"title Attribute",walkthrough_intro_title:"<p>The <strong>title</strong> attribute adds extra information about the selected element. Browsers often show it as a tooltip when the pointer hovers over the element.</p>",walkthrough_title_dir:"dir Attribute",walkthrough_intro_dir:"<p>The <strong>dir</strong> attribute sets the text direction of the element's content: <strong>ltr</strong> (left-to-right), <strong>rtl</strong> (right-to-left), or <strong>auto</strong>. Choosing the default option removes the attribute.</p>",walkthrough_title_lang:"lang Attribute",walkthrough_intro_lang:"<p>The <strong>lang</strong> attribute declares the language of the element or a portion of the page. This helps search engines and browsers. The default option is <strong>-- select a language --</strong>.</p>",walkthrough_title_additional:"Additional Attributes",walkthrough_intro_additional:"<p>Additional attribute fields appear depending on the selected element—for example, <strong>alt</strong>, <strong>src</strong>, <strong>width</strong>, and <strong>height</strong> on images; <strong>href</strong> and <strong>target</strong> on links; table cell attributes; and iframe attributes. Any other attributes already on the element also appear below. You can edit those the same way. If no extra fields are visible now, they will appear when you select an element that has them.</p>",walkthrough_title_complete:"Attributes Walkthrough Complete",walkthrough_intro_complete:'This completes the Attributes tool walkthrough. For more detailed information about using the Attributes tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/attributes" target="_blank">visit the Attributes User Guide article.</a> Happy course building!'},advanced_editor:{title:"Advanced Editor",vanilla_html:"Vanilla HTML",save_changes:"Save Changes",pull_out:"Pull out of sidebar",editor_pulled_out:"The editor tab has been pulled out of the sidebar.  Close the dialog box to restore the editor tab.",lock_element:"Lock element in editor",tab_editor:"editor",tab_id:"id",tab_class:"class",tab_style:"style",row_unwrap:"Unwrap",row_delete:"Delete",html_editor:"HTML Editor",clear_selected:"Clear Selected",child_elements:"Child elements with <code>{attribute}</code> attribute",filter_by:"Filter by {label}",clear_filter:"-- Clear filter --",filter_css_property:"CSS property",unwrap_current:"Unwrap Current Element",unwrap_spans:"Unwrap child span(s)",unwrap_divs:"Unwrap child div(s)",delete_current:"Delete Current Element",delete_empty:"Delete any empty elements",delete_icons:"Delete all icons",replace_nbsp:"Replace non-breaking spaces with normal spaces",empty_label:"Empty",view_id:"View elements with id attributes",view_class:"View elements with class attributes",view_style:"View elements with style attributes",source_canvas:"Canvas {attribute}",source_canvas_editor:"Canvas Editor {attribute}",source_dp:"DesignPLUS {attribute}",source_fa:"DesignPLUS/Font Awesome icons {attribute}",source_legacy:"Legacy DesignPLUS {attribute}",source_unknown:"{attribute} from unspecified source",element_html:"Element HTML",walkthrough_title_overview:"Advanced Editor Walkthrough",walkthrough_intro_overview:"<p>Use the Advanced Editor to edit the HTML of a selected element, unwrap or delete markup, and review id, class, and style attributes on child elements.</p>",walkthrough_title_node_list:"Node List",walkthrough_intro_node_list:"<p>In the <strong>node list</strong>, select the element whose HTML you want to edit. Hover over a node to view its content type.</p>",walkthrough_title_undo_redo:"Undo and Redo",walkthrough_intro_undo_redo:"<p>Use <strong>Undo</strong> and <strong>Redo</strong> to move backward or forward through recent changes in the editor.</p>",walkthrough_title_insert_paragraph:"Insert Paragraph",walkthrough_intro_insert_paragraph:"<p>Use <strong>Add Paragraph Before</strong> and <strong>Add Paragraph After</strong> to insert an empty paragraph above or below the selected element.</p>",walkthrough_title_lock:"Lock Element",walkthrough_intro_lock:"<p>Use <strong>Lock element in editor</strong> to keep the selected element from being edited in the rich content editor. Select it again to unlock the element.</p>",walkthrough_title_unwrap:"Unwrap",walkthrough_intro_unwrap:"<p>Unwrap removes a wrapper and keeps what is inside it. Use <strong>Unwrap Current Element</strong> to unwrap the selected element, <strong>Unwrap child span(s)</strong> to remove span tags inside it, and <strong>Unwrap child div(s)</strong> to remove div tags inside it.</p>",walkthrough_title_delete:"Delete",walkthrough_intro_delete:"<p>Use <strong>Delete Current Element</strong> to remove the selected element. Use <strong>Delete any empty elements</strong> to remove empty elements inside it, <strong>Delete all icons</strong> to remove icons inside it, and <strong>Replace non-breaking spaces with normal spaces</strong> to turn non-breaking spaces into regular spaces.</p>",walkthrough_title_vanilla_html:"Vanilla HTML",walkthrough_intro_vanilla_html:"<p>Use <strong>Vanilla HTML</strong> to remove classes, style attributes, and id attributes from the page content, then load the cleaned HTML into <strong>Element HTML</strong>. Canvas file-link classes are kept.</p>",walkthrough_title_element_html:"Element HTML",walkthrough_intro_element_html:"<p>The <strong>editor</strong> tab shows the HTML for the selected element. Edit the markup in <strong>Element HTML</strong>. Use <strong>Pull out of sidebar</strong> to open the editor in its own dialog, and <strong>Save Changes</strong> to write the HTML back into the selected element.</p>",walkthrough_title_id:"id Attributes",walkthrough_intro_id:"<p>The <strong>id</strong> tab lists child elements that have an id attribute, under <strong>Child elements with id attribute</strong>. Check the elements you want to update, then use <strong>Clear Selected</strong> to remove those ids. If the selected element has no child ids, the list stays empty.</p>",walkthrough_title_class:"class Attributes",walkthrough_intro_class:"<p>The <strong>class</strong> tab lists child elements that have a class attribute, under <strong>Child elements with class attribute</strong>. When classes are present, use <strong>Filter by class</strong> to narrow the list, and the source filters to show or hide classes from Canvas, the Canvas editor, DesignPLUS, DesignPLUS/Font Awesome icons, legacy DesignPLUS, or an unspecified source. Use <strong>Clear Selected</strong> to remove the classes on the checked elements. If the selected element has no child classes, the list stays empty.</p>",walkthrough_title_style:"style Attributes",walkthrough_intro_style:"<p>The <strong>style</strong> tab lists child elements that have a style attribute, under <strong>Child elements with style attribute</strong>. When inline styles are present, use <strong>Filter by CSS property</strong> to narrow the list. Use <strong>Clear Selected</strong> to remove the inline styles on the checked elements. If the selected element has no child styles, the list stays empty.</p>",walkthrough_title_complete:"Advanced Editor Walkthrough Complete",walkthrough_intro_complete:'This completes the Advanced Editor tool walkthrough. For more detailed information about using the Advanced Editor, <a href="https://cidilabs.instructure.com/courses/6630/pages/advanced-editor" target="_blank">visit the Advanced Editor User Guide article.</a> Happy course building!'},wizard:{dtwReview:"Review",dtwToolName:"{tool}",dtwThemeHeading:"Theme",dtwHeadingsHeading:"Headings",dtwImagesHeading:"Images",dtwHeadingIconsHeading:"Heading Icons",dtwContentBlocksHeading:"Content Blocks",dtwTablesHeading:"Tables",dtwLinksHeading:"Links",dtwTextChunkingHeading:"Text Chunking","dtw.refine.headings.iconPickerTooltip":"Icon Picker","dtw.refine.headings.moreOptionsTooltip":"More options","dtw.refine.headings.recentIcons":"Recent Icons","dtw.refine.headings.favoriteIcons":"Favorite Icons","dtw.refine.headings.showLibrary":"Recent and Favorite Icons","dtw.refine.headings.showSuggestions":"Suggested Icons",show_qsw_button:"Show QSW button",show_dtw_button:"Show Transformation Wizard button",dtwReviewSummaryNoRefine:"No further review options",dtwReviewIntro:"Use the tabs or summary links to review each transformation tool. Choose Start Over to change which options are included.",dtwReviewFooterStartOver:"Start Over",dtwReviewFooterStartOverAnnounce:"Returned to transformation options. Adjust your selection and start over.","dtw.ai.sessionHeadings":"Headings AI","dtw.ai.sessionHeadingIcons":"Heading Icons AI","dtw.ai.sessionImageAltText":"Image Alt Text AI","dtw.ai.sessionImageAltTextN":"Image Alt Text AI ({n})","dtw.mergeUpBtn":"Merge above","dtw.mergeDownBtn":"Merge below","dtw.enterBlockBtn":"Edit block","dtw.exitBlockBtn":"Exit block","dtw.splitBelowBtn":"Split Block Below","dtw.unwrapBtn":"Unwrap","dtw.editBlockAnnounce":"Editing content block.","dtw.exitBlockAnnounce":"Exited content block editing.","dtw.previewBlockLabel":"Preview block {n}","dtw.previewBlockItemLabel":"Preview block item {n}","dtw.headingSelection.title":"Choose headings","dtw.headingSelection.description":"Before proceeding, choose any of the headings you would like inserted. Your content must have headings for DesignPLUS Themes and Content Blocks to work properly.","dtw.headingSelection.btn.tryAgain":"Try Again","dtw.headingSelection.btn.proceed":"Proceed","dtw.headingSelection.selectAll":"Select all recommended headings","dtw.headingSelection.selectItem":"Select this heading","dtw.headingSelection.selectItemNamed":"Select heading: {text}","dtw.headingSelection.insertBefore":"Insert before: {text}","dtw.headingSelection.aiGenerated":"AI Generated","dtw.headingSelection.empty":"No suggestions were returned.","dtw.refineTabNav.goTo":"Go to {tab}","dtw.review.stylesRemoved":"Original styles removed.","dtw.processing.stepCompleted":"{option} completed, {done} of {total}.","dtw.processing.stepCompletedSr":"{option} completed","dtw.processing.stepFailedSr":"{option} failed","dtw.refine.headings.iconChanged":"Icon changed to {name}.","dtw.refine.images.toggleDecorative":"Decorative image {n}","dtw.refine.images.toggleMissingAlt":"Image {n}: missing alt text","dtw.refine.images.toggleWithAlt":"Image {n}: {alt}","dtw.refine.images.toggleHasIssue":"{label}, accessibility issue","dtw.welcome.checklist.noContent":"No text content found","dtw.welcome.checklist.noHeadings":"No headings found in the content","dtw.welcome.checklist.headings.checkDescription":"Check heading structure and fix issues before styling","dtw.welcome.headingsWarn.issues":"Heading issues: {n}","dtw.welcome.headingsWarn.suggested":"Suggested headings: {n}","dtw.welcome.headingsWarn.long":"Long sections: {n}","dtw.welcome.headingsWarn.text":"Heading issues can cause problems in other parts of the transformation. Content Blocks and the theme use headings to find where sections start.","dtw.review.statusSkipped":"Not selected","dtw.headingsStep.moduleLabel":"Headings check","dtw.headingsStep.title.none":"Your page needs headings","dtw.headingsStep.title.issues":"A few headings need your call","dtw.headingsStep.title.long":"Some sections are long","dtw.headingsStep.title.good":"Headings look good","dtw.headingsStep.description":"Headings are how screen readers navigate your page, and how the Wizard decides what to style. Settle these before the transformation runs, or choose Continue to leave them as they are.","dtw.headingsStep.notice.none":"This page has no headings yet. Without them the Wizard has nothing to style and the page reads as one long block.","dtw.headingsStep.notice.candidates":"Passages that look like headings are listed below.","dtw.headingsStep.notice.longOne":"One section runs about {n} words with no heading. Breaking it up makes it easier to scan.","dtw.headingsStep.notice.longMany":"{n} sections run over {max} words with no heading. Breaking them up makes them easier to scan.","dtw.headingsStep.notice.clear":"Your heading structure looks good. No skipped levels, no empty headings.","dtw.headingsStep.count.headings":"headings","dtw.headingsStep.count.issues":"issues","dtw.headingsStep.count.suggested":"suggested","dtw.headingsStep.outlineTitle":"Page Outline","dtw.headingsStep.outlineEmpty":"No headings yet. Insert one, or ask AI for suggestions.","dtw.headingsStep.rowOptions":"Heading options: {text}","dtw.headingsStep.imageNoText":"Image — no heading text","dtw.headingsStep.issue.emptyImage":"This heading is an image with no alt text, so screen readers announce an empty heading. You can add alt text to the image after the transformation; the heading will use it as its text.","dtw.headingsStep.issue.empty":"This heading has no text. Remove it, or change it to a paragraph.","dtw.headingsStep.issue.skipped":"This heading skips a level in the outline, so screen reader users hear a missing section.","dtw.headingsStep.issue.long":"Long headings are hard to scan in a heading list. Aim for {n} characters or fewer.","dtw.headingsStep.issue.h1":"Canvas already shows the page title as the H1. Use H2 for the top sections of your content.","dtw.headingsStep.issue.fontSize":"This paragraph has a font size set. If it is structural, make it a heading; otherwise remove the font size.","dtw.headingsStep.issueLabel.empty":"Empty heading","dtw.headingsStep.issueLabel.skipped":"Heading order issue","dtw.headingsStep.issueLabel.long":"Long heading","dtw.headingsStep.issueLabel.h1":"H1 issue","dtw.headingsStep.fix.changeTo":"Change to H{n}","dtw.headingsStep.editLabel":"Heading text","dtw.headingsStep.charCount":"{n} / {max} characters","dtw.headingsStep.updateHeading":"Update heading","dtw.headingsStep.split":"Shorten to “{head}” and move the rest into a paragraph below","dtw.headingsStep.removeHeading":"Remove heading","dtw.headingsStep.changeToParagraph":"Change to paragraph","dtw.headingsStep.levelFor":"Heading level for {text}","dtw.headingsStep.fontSizeSr":"Paragraph with a font size:","dtw.headingsStep.candidateSr":"Looks like a heading:","dtw.headingsStep.makeHeading":"Make heading","dtw.headingsStep.makeHeadingNamed":"Make “{text}” a heading","dtw.headingsStep.dismissNamed":"Dismiss suggestion: {text}","dtw.headingsStep.removeFontSize":"Remove font size","dtw.headingsStep.insertHeading":"Insert heading","dtw.headingsStep.target.table":"Table","dtw.headingsStep.target.list":"List","dtw.headingsStep.target.image":"Image","dtw.headingsStep.composer.title":"New heading","dtw.headingsStep.composer.where":"Insert before: “{text}”","dtw.headingsStep.composer.prev":"Earlier","dtw.headingsStep.composer.next":"Later","dtw.headingsStep.composer.pickHint":"Or click a passage in the preview to insert the heading above it.","dtw.headingsStep.composer.placeholder":"e.g. Before the Quiz","dtw.headingsStep.composer.level":"Level","dtw.headingsStep.composer.fits":"Fits the outline","dtw.headingsStep.composer.skips":"Skips a level","dtw.headingsStep.composer.insert":"Insert","dtw.headingsStep.cancel":"Cancel","dtw.headingsStep.continue":"Continue","dtw.headingsStep.ai.button":"Suggest Headings","dtw.headingsStep.dismiss":"Dismiss","dtw.headingsStep.ai.note":"Optional — sends the whole page (about {n} words) to AI.","dtw.headingsStep.ai.running":"Reading the whole page…","dtw.headingsStep.ai.runningDetail":"Suggesting headings based on what is already written.","dtw.headingsStep.ai.resultsTitle":"Suggested headings: {n}","dtw.headingsStep.ai.resultsHint":"Tick the ones you want. Nothing changes until you apply.","dtw.headingsStep.ai.selectAll":"Select all","dtw.headingsStep.ai.listLabel":"Suggested headings","dtw.headingsStep.ai.applyEdit":"Apply & keep editing","dtw.headingsStep.ai.applyContinue":"Apply & continue","dtw.headingsStep.ai.failed":"Heading suggestions could not be loaded. Try again, or continue without them.","dtw.headingsStep.ai.noneSelected":"Select at least one heading to apply.","dtw.headingsStep.ai.applied":"Headings added: {n}","dtw.headingsStep.announce.level":"Changed to H{n}.","dtw.headingsStep.announce.toParagraph":"Changed to a paragraph.","dtw.headingsStep.announce.removed":"Heading removed.","dtw.headingsStep.announce.updated":"Heading updated.","dtw.headingsStep.announce.dismissed":"Suggestion dismissed.","dtw.headingsStep.announce.fontSizeRemoved":"Font size removed.","dtw.headingsStep.announce.inserted":"Heading inserted.","dtw.headingsStep.summary.clean":"Structure looked good — no changes needed","dtw.headingsStep.summary.reviewed":"Headings carried through: {n}","dtw.headingsStep.summary.remaining":"Issues remaining: {n}","dtw.headingsStep.summary.off":"Not checked","dtw.headingsStep.summary.offLeft":"Not checked — issues: {issues}, suggested headings: {suggested}, long sections: {long} left as-is","dtw.history.undo":"Undo","dtw.history.redo":"Redo","dtw.history.undoWithCount":"Undo, {n}","dtw.history.redoWithCount":"Redo, {n}","dtw.history.undone":"Undone.","dtw.history.redone":"Redone.","dtw.review.footer.bannerImportFailed":"The external banner image file could not be imported to this course.  Do you want to proceed with the external banner image that may not load for students?  If not, cancel applying to the editor and change the banner image first."},style_editor:{title:"Style Editor",quick_styles:"Quick Styles",style_controls:"{context} Style Controls",preview_changes:"Changes are reflected in the {context} preview below.",save_quick_style:"Save {context} Quick Style",save_global_style:"Save as Global Style",clear_style_controls:"Clear Style Controls",quick_style_name:"{context} Quick Style Name",quick_style_name_placeholder:"Quick Style Name",no_quick_styles:"No Quick Styles are currently available.",search_quick_styles:"Search Quick Styles",filter_collections:"Filter By Quick Styles Collection",filter_collections_all:"All Collections",panel_text:"Text",panel_border_bg:"Border & Background",panel_colors:"Colors",panel_spacing_align:"Spacing & Alignment",panel_visibility:"Visibility",panel_advanced:"Advanced",section_text_align:"Text align",section_text_style:"Text style",section_text_color:"Text color",section_font:"Font",section_font_size_px:"Font Size (px)",section_font_style:"Font style",section_border_px:"Border (px)",section_border_style:"Border style",section_border_color:"Border color",section_border_radius:"Border radius",section_background_color:"Background color",section_shadow:"Shadow",section_hover_focus_shadow:"Hover/Focus Shadow",section_margin_px:"Margin (px)",section_padding_px:"Padding (px)",section_alignment:"Alignment",section_vertical_align:"Vertical align",section_canvas:"Canvas",section_printer:"Printer",section_classes:"Classes",section_styles:"Styles",tex