lor, such as #336699.",background_color_label:"Background color",text_color_label:"Text color",apply_recommended_fix:"Apply Recommended Fix",apply_recommended_fix_hint:"Applies the closest passing text and background colors that meet 4.5:1 contrast, preferring inline style changes.",recommended_preview_label:"Recommended fix",white_text:"White text",black_text:"Black text",white_text_hint:"Applies white text as {mode}. {pairing}",black_text_hint:"Applies black text as {mode}. {pairing}",text_mode_inline:"inline",text_mode_class:"class",default_background:"Default background",default_text:"Default text",default_text_hint:"Removes the inline text color so the text uses the page default. Prefer this for near-black or gray text that does not need to stay a custom color.",recheck_label:"Recheck",recheck_all_colors:"Recheck all colors",recheck_complete:"Recheck complete",reset_preview:"Reset",preview_reset:"Preview restored to original colors.",adjust_manually:"Adjust manually",more_options:"More options",locate_in_editor:"Locate in editor",locate_choose_instance:"Choose instance",locate_choose_instance_count:"Choose instance, {n} total",locate_instance_option:"Locate instance {current} of {total}: {tag}, {snippet}",locate_empty_snippet:"Empty element",current_values:"Current values",recommended_fix_heading:"Recommended fix",recommended_values_heading:"Recommended values",manual_values_heading:"Manual values",remediation_tab_recommended:"Recommended",remediation_tab_manual:"Manual",image_overlay_manual_intro:"Choose another passing overlay. Shown: lowest-opacity AA and AAA options for light and dark text.",image_overlay_text_light:"Light text",image_overlay_text_dark:"Dark text",image_overlay_text_current:"Keep current text color",image_overlay_no_alternates:"No other passing overlays were found for this image. Use the Background tool for more mask options.",apply_to_editor:"Apply to Editor",apply_manual_fix:"Apply Manual Fix",browser_label:"Browser",gradient_stop_name:"Stop {n} ({position})",gradient_stop_ratio:"{ratio}:1",gradient_adjust_intro:"Adjust gradient stops that fail contrast under this text:",gradient_show_all_stops:"Show all stops",use_recommended:"Use",text_lightness_label:"Text lightness",background_lightness_label:"Background lightness",locate_count:"{current} of {total}",locate_step:"Locate in editor, {current} of {total}",all_instances:"All instances",inline_color_set:"Inline color: {color}",background_class_set:"Background: {value}",text_color_summary:"Text: {color}",background_color_summary:"Background: {color}",text_color_summary_with_source:"Text: {color} {source}",background_color_summary_with_source:"Background: {color} {source}",color_source_inline:"(inline)",color_source_class:"(CSS class)",color_source_class_named:"({className})",color_source_default:"(default)",gradient_background_summary_with_source:"Background: gradient {source}",update_html_background:"Preview updated background",html_mirror_drift_notice:"The mirrored background no longer matches the current class background. Preview the updated color, then apply to stay in sync with branding.",guidance_sections_label:"Guidance sections",fix_options_label:"Fix options",guidance_dark_mode_tab:"Dark mode",guidance_html_report_tab:"Scanner warnings",guidance_card_badge_dark_mode:"Dark mode",guidance_card_badge_html_report:"Scanner warnings",contrast_results_label:"Contrast results",ratio_label:"Ratio",normal_label:"Normal",large_label:"Large",try_beta:"Try beta Contrast Checker",use_classic:"Use classic Contrast Checker",beta_reload_notice:"The page will reload to switch versions.",gradient_background_unchanged:"Gradient (unchanged)",gradient_recommended_text_fix:"Use {text} text on this gradient",gradient_adjust_fallback_intro:"White and black text do not pass everywhere on this gradient. Adjust failing stops below:",gradient_text_fix_intro:"White or black text passes on this gradient. Use the buttons above, or adjust gradient stops below if needed.",gradient_adjust_stops_details:"Adjust gradient stops",image_overlay_analyzing:"Analyzing image for overlay recommendations…",image_overlay_recommended:"Recommended: {mask} ({wcag})",image_overlay_load_failed:"Could not analyze this image. Use the Background tool to choose an overlay manually.",image_overlay_no_recommendation:"No automatic overlay recommendation for this image. Use the Background tool to try overlays manually.",image_overlay_text_class_note:"Also updates text color to match {textClass} (replacing inline colors that would still fail).",image_bg_tool_tip:"More overlay options are in the Background tool.",image_bg_dismiss_warnings:"Dismiss text contrast warnings for this image",image_bg_not_used_for_text:"According to a content flag in the Background tool, this image is not used as the background for text.",apply_all_recommended:"Apply all recommended",apply_all_recommended_count:"Apply all recommended ({n})",apply_all_recommended_confirm:"Apply the recommended fix to all {n} items in this section? Scan the recommendations first — this may change colors, overlays, and styles across the page.",apply_all_recommended_confirm_filtered:"Apply the recommended fix to all {n} {type} items? Scan the recommendations first — this may change colors, overlays, and styles across the page.",a11y_all_recommended_applied:"Applied recommended fixes to {n} items.",translucent_bg_recommended_note:"Uses a solid background (same look on a white page) so contrast does not depend on what is behind the transparency.",apply_hint_change_text_color:"Change text color to {hex}",apply_hint_change_bg_and_text:"Change background to {bgHex} and text to {textHex}",apply_hint_change_bg_color:"Change background color to {hex}",apply_hint_apply_text_class:"Apply {text} class",apply_hint_adjust_gradient_stops:"Adjust gradient stops for sufficient contrast",wcag_unknown:"Unknown",wcag_ratio_unavailable:"—",dark_mode_recommended_default_text:"Use default text (remove inline color)",dark_mode_recommended_darkmode_safe:"Keep browser color; add dark mode fix class",guidance_dark_section_notice:"An inline dark text color reads fine in the browser but stays dark on the dark background of the Canvas mobile app, making it unreadable. Try the recommended fix, or choose another option and apply when ready.",guidance_dark_why_heading:"Why dark mode matters",guidance_dark_why_body:"An inline dark text color reads fine in the browser but stays dark on the dark background of the Canvas mobile app, making it unreadable. Try the recommended fix, or choose another option and apply when ready.",guidance_html_section_notice:"Try the recommended fix below, or open Why scanners flag this for details on scanners versus the editor.",guidance_html_why_heading:"Why scanners flag this",guidance_html_why_static_vs_computed:"Many HTML accessibility scanners read literal colors in the style attribute and assume a default background (often white). The editor uses computed colors from CSS classes, so the page can look fine while a scanner fails.",guidance_html_why_class_text:"The reverse also happens: a class may set light text while an ancestor has an inline background. Scanners see the background but miss the class text color, so they assume default gray text and fail.",guidance_html_why_tradeoffs:"Scanner fix keeps your text color and adds a literal background for scanners, but that hex can drift if branding changes. White text or Default text is simpler and may avoid drift, but changes how the text looks.",guidance_html_why_disclaimer:"DesignPLUS cannot guarantee how every vendor checker scores colors. This guidance targets the common pattern of literal style colors against an assumed background.",html_recommended_mirror:"Keep your text color; add a literal background for scanners",html_recommended_white_text:"Use a white text class (not an inline color) so scanners and the editor both see sufficient contrast",html_recommended_inline_text_color:"Add an inline text color on the background element so scanners see the same contrast the editor shows",html_recommended_default_text:"Use default text (remove inline color) so scanners inherit readable colors",editor_label:"Editor",html_checker_label:"HTML checker"},heading_checker:{a11y_empty_heading:"Empty Heading",a11y_heading_level_down:"Adjust heading level down for {text}, from {from} to {to}",a11y_heading_level_down_disabled:"Cannot adjust heading level down for {text}, already {from}",a11y_heading_level_up:"Adjust heading level up for {text}, from {from} to {to}",a11y_heading_level_up_disabled:"Cannot adjust heading level up for {text}, already {from}",a11y_issue_for_heading:"Heading {n} of {total}, {issue}",a11y_level_adjust_group:"Adjust heading level",change_heading_level:"Change heading, {text}, from {from} to {to}",classicQuizNotice:'<p class="my-0">Canvas adds H2 headings before classic quiz instructions and questions. The Heading Checker will flag any H1 headings and will allow the first heading to be H3.</p>',h1InQuiz:"H1 is not allowed in classic quizzes. Canvas already provides the quiz title as H1.",h1NonDp:"H1 should be a Banner Title - Click to convert",h1NonDp_tip:"H1 should be a Banner Title",h1Order:"H1 must come first - Click to move to top of page",h1Order_tip:"H1 must come first",h1ShowTitle:"H1 should hide Canvas title - Click to hide",h1ShowTitle_tip:"H1 should hide Canvas title",headingLocked:"Locked",multipleH1s:"Multiple H1 Headings Found",noHeadings:"No headings found",outOfOrder:"Out of order",paragraphFontSize:"Should this be a heading? Click to remove font-size",paragraphIgnore:"Dismiss",paragraphSizeNotice:'<p class="mt-0">Use caution when setting a font size for an entire paragraph. If it is structural, use a heading instead.</p>\n                    <p class="mb-0">The default font size meets accessibility guidelines and allows users to easily increase/decrease font size with native browser controls.</p>',refreshHeadings:"Refresh Heading List",structureNotice:'<p class="my-0">Headings indicate the importance of content and should be nested properly to help users navigate content. Skipping levels should be avoided. Pages should have only one H1 level heading.  H1 headings must come first and should hide the Canvas H1 title.</p>',title:"Heading Checker"},image_checker:{alt_placeholder:"(Describe the image)",alt_title_labeled:'Alt Text<span class="sr-only">, image {n} of {total}</span>',decorative_labeled:'Decorative<span class="sr-only">, image {n} of {total}</span>',empty_list:"No images found on this page.",info_notice:'<p class="my-0">Alternative Text (Alt Text) is an alternative (non-visual) way to describe the meaning of an image. Please provide a brief description of the image for a screen reader user.</p>',msg_add_alt_suggestion:"Add alt text if this image conveys information",msg_avoid_phrase:'Avoid using the phrase, "{phrase}" in the alt text.',msg_no_filename_alt:"Do not use the file name for alt text",msg_set_alt_or_decorative:"Set alt text or mark as decorative",row_label:"Image {n} of {total}",suggest_alt_labeled:'Suggest Alt Text<span class="sr-only">, image {n} of {total}</span>',title:"Image Alt Checker"},link_checker:{alt_text:"Alt Text",alt_text_labeled:'Alt Text<span class="sr-only">, link {n} of {total}</span>',delete_link_labeled:'Delete Link<span class="sr-only">, link {n} of {total}</span>',different_course:'<p class="my-0">Link points to a different course.</p>',edit_link:"Edit Link",edit_link_n:"Edit Link, {n} of {total}",edit_link_needs_review:"Edit Link, needs review, {n} of {total}",empty_list:"No links found on this page.",info_notice:"<p class=\"my-0\">Links should make sense out of context. Links should be descriptive of the content they're linking to, such as 'Class Schedule' rather than 'schedule.html' or 'click here'.</p>",link_content:"Link Content",link_content_labeled:'Link Content<span class="sr-only">, link {n} of {total}</span>',link_destination:"Link Destination",link_destination_labeled:'Link Destination<span class="sr-only">, link {n} of {total}</span>',link_removed:"Link removed",link_unwrapped:"Link unwrapped",link_word_unnecessary:'<p class="my-0">The word "link" is usually unnecessary, users know it\'s a link.</p>',more_descriptive:'<p class="my-0">Use more descriptive link text.</p>',no_content:'<p class="my-0">This link has no content.</p>',no_destination:'<p class="my-0">This link has no destination.</p>',screen_reader:"Screen Reader:",screen_reader_empty:"(no accessible name)",status_scan:"{n} links, {m} need review",suggest_link_text_labeled:'Suggest Link Text<span class="sr-only">, link {n} of {total}</span>',title:"Link Checker",unwrap_link_labeled:'Unwrap Link<span class="sr-only">, link {n} of {total}</span>'},math_checker:{alt_clear_name:"Clear, equation image {n} of {total}",alt_decorative:"Decorative",alt_placeholder:"(Describe the equation image)",alt_save:"Update Alt Text",alt_save_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',alt_title:"Alt Text",alt_title_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',alt_updated:"Alt text updated",decorative_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',dismiss_expression:"Dismiss Equation Image",dismiss_expression_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',empty_list:"No equation images were found.",expression_remove:"Remove Equation Image",expression_remove_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',expression_remove_name:"{label}, equation image {n} of {total}",fix_escaped_braces:"Remove escaped braces - use { and } instead of \\{ and \\}",fix_frac_args:"Ensure \\frac{}{} has both numerator and denominator",fix_prime_f:"Use f' instead of f^{\\prime}",fix_prime_quote:"Replace \\prime with a single quote (')",fix_text_braces:"Ensure \\text{} commands have proper braces",hide_alt_suggestion:"Hide Alt Suggestion",hide_alt_suggestion_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',hide_suggestion:"Hide Suggestion",latex_error_prefix:"TeXZilla error converting LaTeX to MathML. ",latex_error_suffix:"If possible, simplify the LaTeX expression and try again. Otherwise, manually set the Alt Text.",latex_error_suggestions:"Suggestions: {suggestions}. ",msg_add_alt_or_decorative:"Add alt text for equation images or mark decorative",msg_no_filename_alt:"Do not use the file name for alt text",msg_no_latex_alt:"Do not use LaTeX for alt text",review_dismissed:"Review Dismissed Items ({count})",row_label:"Equation image {n} of {total}",scan_again:"Scan Again",scan_result_one:"1 equation image found.",scan_result_other:"{count} equation images found.",suggestion_latex:'<p class="my-0 alt-suggestion">Suggested alt text: {suggestion}</p>{applySuggestion}',suggestion_latex_error:'<p class="my-0 alt-suggestion">{error}</p>',suggestion_restore:"Show Alt Suggestion",suggestion_restore_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',suggestion_restore_name:"{label}, equation image {n} of {total}",suggestion_use:"Use Suggested",suggestion_use_labeled:'{label}<span class="sr-only">, equation image {n} of {total}</span>',title:"Math Checker"},table:{title:"Table",table:"Table",row:"Row",column:"Column",cell:"Cell",state_table:"table",state_row:"row",state_column:"column",state_cell:"cell",delete_state:"Delete {state}",table_width:"W",width_type:"Type",table_height:"H",height_type:"Type",width_popup:"<p>Set the {state} width (optional)</p>",height_popup:"<p>Set the {state} height (optional)</p>",clear_widths:"Clear all widths in {state}",clear_heights:"Clear all heights in {state}",clear_width_label:"Width",clear_height_label:"Height",convert:"Convert Table to Columns",structure:"Headers/Footer",structure_column_headers:"Column Headers",structure_row_headers:"Row Headers",structure_footer_row:"Footer Row",structure_caption:"Caption",structure_caption_top:"Caption Top",structure_caption_bottom:"Caption Bottom",caption:"Table Caption",options:"Other Options",advanced_sortable:"Sortable",advanced_hover:"Row Hover",advanced_striped:"Striped Rows",advanced_condensed:"Condensed",advanced_scroll:"Scroll on small screens",sortable_notice:"The functionality to display sortable tables in Dialog Boxes is currently under development. Sortable tables will still display properly in popovers.",style_studio:"Table Style Studio",base_style:"Base Style",border_style:"Border Style",style_remove:"Default / No Style",style_light:"Light",style_dark:"Dark",style_canvas:"Canvas",border_style_default:"Default / Horizontal",border_style_all:"All",border_style_none:"No Borders",align_left_top:"Align Left Top",align_center_top:"Align Center Top",align_right_top:"Align Right Top",align_left_middle:"Align Left Middle",align_center_middle:"Align Center Middle",align_right_middle:"Align Right Middle",align_left_bottom:"Align Left Bottom",align_center_bottom:"Align Center Bottom",align_right_bottom:"Align Right Bottom",column_heading:"Column Heading",cell_content:"Content",wt_advanced_intro:"In the Advanced panel, choose from additional structure and styling options.",wt_advanced_title:"Advanced",wt_alignment_intro:"Use the <strong>Alignment</strong> controls to align contents horizontally and vertically.",wt_alignment_title:"Alignment",wt_base_style_intro:"The Base Style sets the table's background colors. Choose from a light background, a dark background, or the Canvas default table style (white background, increased cell padding).",wt_border_style_intro:"Use the <strong>Border Style</strong> controls to apply default/horizontal borders, all (horizontal/vertical) borders, or no borders.",wt_caption_intro:"Use the <strong>Table Caption Options</strong> to add table captions and style their location and text alignment.",wt_caption_title:"Table Caption Options",wt_cell_intro:"With the <strong>Cell</strong> option selected, you can set or clear width and height for the selected cell.",wt_cell_title:"Table Structure: Cell",wt_clear_intro:"Use the <strong>Clear Widths</strong> and <strong>Clear Heights</strong> buttons to remove any specific width or height settings.",wt_clear_title:"Clear Widths and Heights",wt_column_intro:"With the <strong>Column</strong> option selected, only width can be set or cleared.",wt_column_title:"Table Structure: Column",wt_complete_intro:'This completes the Table tool walkthrough. For more information about the Table tool, visit the <a href="https://cidilabs.instructure.com/courses/6630/pages/tables" target="_blank">Table tool User Guide article.</a>',wt_complete_title:"Table Walkthrough Complete",wt_convert_intro:"Use the <strong>Convert Table to Columns</strong> button to convert the table to responsive columns.",wt_delete_intro:"Use the <strong>Delete</strong> button to remove the selected table structure contents from the RCE.",wt_delete_title:"Delete Selected Table Structure",wt_header_footer_intro:"Use the <strong>Header/Footer Options</strong> to add column and row headers as well as table footer rows.",wt_header_footer_title:"Header/Footer Options",wt_height_intro:"Adjust the selected table structure's height as pixels, em, or as a percentage of the element's total height.",wt_height_title:"Set Height",wt_intro:"With this tool, you can build and style tables in content as well as convert tables to columns.",wt_intro_title:"Table Walkthrough",wt_options_intro:"Use the <strong>Other Options</strong> to make the table sortable, apply striped row styling, emphasize rows on hover, apply the condensed style that minimizes padding around the table, and set tables to scroll on small screens.",wt_row_intro:"With the <strong>Row</strong> option selected, you can clear widths and heights from the current row, but specific widths and heights cannot be set.",wt_row_title:"Table Structure: Row",wt_structure_continued_intro:"Alignment controls, the Convert Table to Columns button, and the Delete button are always available. Other controls in the Content panel vary slightly depending which table structure you are targeting.",wt_structure_continued_title:"Table Structure Continued",wt_structure_intro:"Select the table element you'd like to apply changes to in the selected table. Choose Table, Row, Column, or Cell.",wt_structure_title:"Table Structure",wt_style_intro:"Use the controls in the Style panel to adjust the table's <strong>Base Style</strong> and <strong>Border Style.</strong>",wt_style_title:"Style",wt_width_intro:"Adjust the selected table structure's width as pixels, em, or as a percentage of the element's total width.",wt_width_title:"Set Width"},table_checker:{add_header_scopes:"Add Header Scopes",caption_not_needed:"No caption needed",caption_not_needed_title:"This table does not need a caption",column_headers:"Column Headers",convert_to_columns:"Convert Table to Columns",info_notice:'<p class="my-0">The purpose of data tables is to present tabular information in a grid, or matrix, and to have column or rows that show the meaning of the information in the grid.</p>\n                <p class="my-0">Table headers provide a description of the table structure for sighted and screen reader users.</p>',notice_caption:"Table captions can help users to find a table, understand what it's about, and decide if they want to read it. Table captions are useful but not required.",notice_header:'<p class="my-0">Choose header direction</p>',notice_scope:'<p class="my-0">Missing header scopes</p>',row_headers:"Row Headers",scan_again:"Scan Again",show_table:"Show table in editor",table_caption:"Table Caption",table_label:"Table",title:"Table Checker"},module_list:(0,p.A)({refresh_cache:"Refresh Module List (last {date})"},{title:"Module List"}),inputs:{title:"Input",inputsLabel:"Input Elements",inputText:"Text Input",inputTextArea:"Text Area",inputRadio:"Radio Input",inputCheckbox:"Checkbox Input",inputRadioList:"Radio Input List",inputCheckboxList:"Checkbox Input List",hideLabel:"Hide input label",hideLabels:"Hide input labels",labelText:"Label",customWidth:"Custom width",inputWidth:"Input width",matchCheckbox:"Enable correct answer",matchValue:"Correct answer text",caseSensitive:"Answer is case sensitive",toggleContent:"Show hidden content when correct",dataRows:"Text area size",placeholderText:"Placeholder text",dataName:"Radio button group name",dataNameNotice:"The radio button group name must be unique because it is used to group the radio buttons together. It is not displayed to the user.",wt_intro_title:"Inputs Walkthrough",wt_intro_intro:"<p>Use the <strong>Inputs</strong> tool to add text, text area, radio, checkbox, and list input elements to course content.</p>",wt_input_elements_title:"Input Elements",wt_input_elements_intro:"<p>Choose from <strong>Text Input</strong>, <strong>Text Area</strong>, <strong>Radio Input</strong>, <strong>Checkbox Input</strong>, <strong>Radio Input List</strong>, or <strong>Checkbox Input List</strong>. Edit list options as list items in the Rich Content Editor.</p>",wt_label_title:"Label",wt_label_intro:"<p>Enter the label displayed beside the text input.</p>",wt_hide_label_title:"Hide Input Label",wt_hide_label_intro:"<p>Select <strong>Hide input label</strong> when the input label should remain available to assistive technology but not appear visually.</p>",wt_custom_width_title:"Custom Width",wt_custom_width_intro:"<p>Enable <strong>Custom width</strong> to display the <strong>Input width</strong> field and set a specific width for the text input.</p>",wt_input_width_title:"Input Width",wt_input_width_intro:"<p>Set the text input width. This field appears after <strong>Custom width</strong> is enabled.</p>",wt_correct_answer_title:"Enable Correct Answer",wt_correct_answer_intro:"<p>Enable a correct answer to display the <strong>Correct answer text</strong> and <strong>Answer is case sensitive</strong> controls.</p>",wt_correct_answer_text_title:"Correct Answer Text",wt_correct_answer_text_intro:"<p>Enter the response students must provide for the answer to be marked correct.</p>",wt_case_sensitive_title:"Case Sensitive Answer",wt_case_sensitive_intro:"<p>Select <strong>Answer is case sensitive</strong> when capitalization must match the correct answer text.</p>",wt_placeholder_text_title:"Placeholder Text",wt_placeholder_text_intro:"<p>Enter the placeholder text displayed inside a text area.</p>",wt_text_area_size_title:"Text Area Size",wt_text_area_size_intro:"<p>Set the number of rows displayed in the text area.</p>",wt_radio_group_name_title:"Radio Button Group Name",wt_radio_group_name_intro:"<p>Give related radio inputs the same unique group name so students can select only one option in that group. The name is not displayed to students.</p>",wt_preview_title:"Preview",wt_preview_intro:"<p>The <strong>Preview</strong> panel provides an interactive view of the rendered input.</p>",wt_complete_title:"Inputs Walkthrough Complete",wt_complete_intro:'This completes the Inputs tool walkthrough. For more detailed information about using the Inputs tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/inputs" target="_blank">visit the Inputs tool User Guide article.</a> Happy course building!'},course_external_assets:{aboutIssueType:"About {issue}",actions:"Actions",actionOutcomeAnnounce:"{name}: {message}",allIssues:"All Issues",allStatuses:"All Statuses",asset:"Asset",bulkConfirm:"Are you sure you want to make changes to all selected items?",bulkConfirmDismiss:"Dismiss {n} selected assets? This updates course content.",bulkConfirmFlag:"Flag {n} selected assets? This updates course content.",bulkConfirmImport:"Import and update {n} selected assets? This updates course content.",cancel:"Cancel",continue:"Continue",countHeader:"Count",courseAsset:"Course Asset:",currentAsset:"External Asset:",differentCourseFilesText:"Files that are stored in a different course in Canvas",differentCourseLinksText:"Links to different courses in Canvas",dismiss:"Dismiss",duplicateLegend:"How do you want to resolve this duplicate?",duplicateWarning:"A file with the same name as the external asset was found in your course. You can update the content with the course file or import, rename, and update with the external file.",duplicateWarningMultiple:"Multiple files with the same name as the external asset were found in your course. You can update the content with one of the course files or import, rename, and update with the external file.",externalAssetLabel:"External Asset:",externalFilesText:"Files that are hosted outside of Canvas",externalLinksText:"Links to websites outside of Canvas",failed:"Failed",fileName:"File Name",fileNotFoundAnnounce:"{name} is not available. Status: File not found.",flag:"Flag",foundIn:"Found in",importAndUpdate:"Import and Update",importAndUseThisFile:"Import and use this file",importDestinationFolder:"Import Destination Folder",issue:"Issue",issueDifferentCourseFile:"Different Course File",issueDifferentCourseLink:"Different Course Link",issueExternalFile:"External File",issueExternalLink:"External Link",issueTypeHeader:"Issue Type",msgDismissed:"Dismiss successful!",msgDismissFailed:"Dismiss failed",msgFlagged:"Flag successful!",msgFlagFailed:"Flag failed",msgImported:"Import and Update successful!",msgImportFailed:"Import & Update Failed",msgPartialDismiss:"Dismiss <strong>partially</strong> successful.",msgPartialFlag:"Flag <strong>partially</strong> successful.",msgPartialImport:"Import and Update <strong>partially</strong> successful.",msgTryAgainSupport:'Try again or <a href="{url}" target="_blank" rel="noopener">visit Cidi Labs support</a> for help.',noMatches:"No matches found.",paginationNav:"Review results pages",preparingScan:"Preparing course scan…",previouslyDismissed:"{n} external {assetPlural} previously dismissed",processing:"Processing…",processingNamed:"Processing {name}",published:"Published",resultsAnnounce:"{n} assets flagged for review",review:"Review Flagged Assets",reviewAssets:"Review Assets",reviewTableCaption:"External assets for review",reviewTitle:"Review External Assets",rowDifferentCourseFiles:"Different Course Files",rowDifferentCourseLinks:"Different Course Links",rowExternalFiles:"External Files",rowExternalLinks:"External Links",scanAgain:"Scan Course Again",scanCourse:"Scan Course",scanFailed:"The course scan failed. Try scanning again.",scanFailedAnnounce:"Course scan failed. Try scanning again.",scanNotice:"Scan this course to find and import any external files or images.",scanProgress:"Scanning the course. {completed} of {expected} API calls completed.",scanTypeComplete:"{type} complete",scanTypeFailed:"{type} failed",scanTypeScanning:"{type} scanning",search:"Search",searchPlaceholder:"Search assets",selectAll:"Select All",selectAllOnPage:"Select all rows on this page",selectAsset:"Select {name}",selectedCount:"{count} selected",sourceCourse:"Source: course {courseId}",sourceHost:"Source: {host}",status:"Status",statusDismissed:"Dismissed",statusDismissFailed:"Dismiss Failed",statusFileNotFound:"File not found",statusFlagFailed:"Flag Failed",statusFlagged:"Flagged",statusFlaggedOrNotFound:"Flagged / File not Found",statusImportFailed:"Import & Update Failed",statusPartial:"Partially Imported & Updated",statusPartiallyDismissed:"Partially Dismissed",statusPartiallyFlagged:"Partially Flagged",statusTriggerLabel:"{status}: {name}",statusUpdated:"Imported & Updated",successful:"Successful",title:"External Assets",total:"Total",unpublished:"Unpublished",unselectAll:"Unselect All",untitledAsset:"Untitled asset",updateWithExistingHint:"This option will update the link to point to the existing file rather than importing a duplicate file.",updatedAsset:"Imported Asset:",useCourseFileNamed:"Use course file {filename}"},heading_advanced:{title:"Custom Headings",heading_level_n:"H{n}",wtIntroTitle:"Custom Headings Walkthrough",wtIntroText:"<p>Use the Custom Headings tool to create and save custom heading styles for the page (H2–H6), including colors, borders, width, padding, and heading icons.</p>",wtPreviewTitle:"Preview",wtPreviewIntro:"<p>Check <strong>Preview</strong> to show or hide the popout preview, which reflects your current heading style selections.</p>",wtHeadingLevelTitle:"Heading Level",wtHeadingLevelIntro:"<p>Use <strong>All</strong> or a specific level (<strong>H2</strong>–<strong>H6</strong>) to choose which headings the style controls apply to. <strong>All</strong> updates every heading level at once.</p>",wtResetStyleTitle:"Reset Style",wtResetStyleIntro:"<p>Select <strong>Reset Style</strong> to remove the current custom heading classes from the page wrapper.</p>",wtHeadingsTitle:"Headings",wtHeadingsIntro:"<p>Open the <strong>Headings</strong> panel to set colors, style, border width, width, and padding for the selected heading level.</p>",wtHeadingColorsTitle:"Heading Colors",wtHeadingColorsIntro:"<p>Use the <strong>Colors</strong> controls to set background, text, and border colors for the selected heading level. The available pickers change when you choose <strong>All</strong> versus a single heading.</p>",wtStyleTitle:"Style",wtStyleIntro:"<p>Use the <strong>Style</strong> buttons to apply heading treatments such as bold or border positions.</p>",wtBorderWidthTitle:"Border Width",wtBorderWidthIntro:"<p>Use <strong>Border Width</strong> to control how thick heading borders appear.</p>",wtHeadingWidthTitle:"Heading Width",wtHeadingWidthIntro:"<p>Use <strong>Heading Width</strong> to choose Full Width Left, Full Width Centered, Fit Content Left, or Fit Content Centered.</p>",wtHeadingPaddingTitle:"Heading Padding",wtHeadingPaddingIntro:"<p>Use <strong>Heading Padding</strong> to choose <strong>Default</strong>, <strong>All</strong>, or <strong>Custom</strong>. <strong>Custom</strong> reveals direction (T/B/L/R) and <strong>Padding Size</strong>. <strong>All</strong> also reveals <strong>Padding Size</strong>.</p>",wtHeadingIconsTitle:"Heading Icons",wtHeadingIconsIntro:"<p>Open the <strong>Heading Icons</strong> panel to style icons that appear on headings.</p>",wtIconColorsTitle:"Icon Colors",wtIconColorsIntro:"<p>Use <strong>Icon Colors</strong> to set icon background, text, and border colors for the selected heading level.</p>",wtIconStyleTitle:"Icon Style",wtIconStyleIntro:"<p>Use <strong>Icon Style</strong> to apply style treatments to heading icons.</p>",wtIconSizeTitle:"Icon Size",wtIconSizeIntro:"<p>Use <strong>Icon Size</strong> to choose <strong>Default</strong>, <strong>Inset</strong>, <strong>Fill</strong>, or <strong>Overflow</strong>.</p>",wtIconPositionTitle:"Icon Position",wtIconPositionIntro:"<p>Use <strong>Icon Position</strong> to place the icon Left (Default), Right, Top Center, or Bottom Center.</p>",wtIconBorderWidthTitle:"Icon Border Width",wtIconBorderWidthIntro:"<p>Use <strong>Icon Border Width</strong> to control the thickness of the icon border.</p>",wtCustomStylesTitle:"Custom Styles",wtCustomStylesIntro:"<p>In <strong>Custom Styles</strong>, enter a <strong>Custom Style Title</strong>, then select <strong>Save Custom Style</strong> to store the current configuration. Apply, rename, update, or delete saved styles from the list. If you already have favorites, use <strong>Save Changes</strong> to update them.</p>",wtCurrentClassesTitle:"Current Classes",wtCurrentClassesIntro:"<p>The <strong>Current Classes</strong> field shows the CSS classes on the page wrapper. You can edit these classes directly.</p>",wtCompleteTitle:"Custom Headings Walkthrough Complete",wtCompleteIntro:'This completes the Custom Headings walkthrough. For more detailed information about using the Custom Headings tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/custom-headings" target="_blank">visit the Custom Headings User Guide article.</a> Happy course building!'},link_grid:{title:"Link Grid",search_title:"Link Grid Styles",large_link_grid:"Large Link Grid",items:"Items",placeholder:"Placeholder",item_link:"Link",new_item:"New Item",duplicate:"Duplicate",clear_style:"Clear Style",add_to_favorites:"Add to Favorites",remove_from_favorites:"Remove from Favorites",style_studio:"Link Grid Style Studio",lg_columns:"Large screen - {n} column",md_columns:"Medium screen: {n} column",sm_columns:"Small screen: {n} column",wt_intro_title:"Link Grid Walkthrough",wt_intro:"Use this tool to create a grid-formatted link display and add menus to pages for students to navigate the course.",wt_content_title:"Content",wt_content_intro:"In the <strong>Content</strong> panel, use the controls to add or remove items in a link grid, change the text alignment of the link grid, edit link grid item text, and open the <strong>Link tool</strong> for individual link grid items to update their URLs. You can also add an icon to each link grid item by using their respective ",wt_icon_pickers:"<strong> Icon Pickers.</strong>",wt_style_title:"Style",wt_style_intro:"In the <strong>Style</strong> panel, you can set link grid columns for various screen sizes, apply the large link grid style, and search, favorite, and apply predefined link grid styles. Use the ",wt_no_style_button:"<strong> No Style</strong> button to clear styles from the selected link grid.",wt_columns_title:"Link Grid Columns",wt_columns_intro:"<p>Use the column controls to set the number of columns for the link grid on a large, medium, and small display.</p>",wt_filter_title:"Filter Link Grid Styles",wt_filter_sources_intro:"Choose a collections panel from the filter dropdown to display and select available styles from that source. You can also search for styles by name and filter styles by source by checking or unchecking the source icons for:",wt_filter_current_course:"current course (if available)",wt_filter_extended_course:"extended customizations course (if available)",wt_filter_primary_course:"primary customizations course",wt_filter_icons_intro:"<p>The source course is also indicated by the corresponding icon on each style button. Unchecking a source button removes any stylees from that source.</p>",wt_apply_title:"Apply Link Grid Styles",wt_apply_intro:"In the Collections panels, you can view and apply available link grid styles. Once you've applied a style, use the ",wt_add_favorites_button:"<strong> Add to Favorites</strong> button above the Customizations Controls field to favorite a selected style.",wt_complete_title:"Link Grid Walkthrough Complete",wt_complete_intro:'This completes the Link Grid tool walkthrough. For more detailed information about using the Link Grid tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/link-grids" target="_blank">visit the Link Grids User Guide article.</a> Happy course building!'},student_cards:{show_student_cards:"Student Cards",show_user_cards:"User Cards",show_student_list:"Student List",show_user_list:"User List",only_users_with_pictures:"Only Users with Pictures",missing_someone_heading:"Missing someone?",missing_someone_body:"This is an add on that manipulates the view of the student list in Canvas. Change back to the student list and make sure Canvas has loaded all students before switching to student cards."},preview_content:{title:"Preview Content",outline_label:"Remove DesignPLUS outlines and labels from the editor",dark_mode:"Preview in dark mode",refresh_content:"Refresh Content",screen_resolutions:"Common Screen Resolutions",fill_window:"Fill Window",a11y_iframe_title:"Rendered Content Preview",loading_preview:"Loading Preview...",modal_title:"Content Preview"},edit:{panel_design_assistant:"Design Assistant",panel_content:"Content",panel_style:"Style",panel_advanced_style:"Quick Styles",panel_advanced:"Advanced",panel_preview:"Preview",panel_app_preview:"App Preview",no_matching_tools:"No matching tools found for the selected content.",badge_dev:"DEV",badge_beta:"BETA",loading:"Loading...",edit_toolbar_legend:"Edit Toolbar",skip_edit_toolbar:"Skip edit toolbar",shortcuts:"Shortcuts",select_tool:"Select {name}",delete_tool:"Delete {name}",duplicate_tool:"Duplicate {name}",cut_tool:"Cut {name}",copy_tool:"Copy {name}",clear_tool_styles:"Clear {name} Styles",move_tool_up:"Move {name} Up",move_tool_down:"Move {name} Down",remove_empty_elements:"Remove Empty Elements",refresh_customizations:"Refresh Customizations",refreshing_customizations:"Refreshing Customizations",shortcut_style_editor:"Load {name} in Style Editor",shortcut_attributes:"Load {name} in Attributes",shortcut_advanced_editor:"Load {name} in Advanced Editor",shortcut_arrange:"Load {name} in Arrange Content",a11y_moved_up:"{name} Moved up",a11y_moved_down:"{name} Moved down"},link_grid_advanced:{title:"Custom Link Grid",no_link_grid_found:"No Link Grid Found",no_link_grid_found_body:"Add a new link grid or put your cursor in an existing link grid to use this tool."},links_course:{title:"Course Links",search:"Search Course Links",refresh:"Refresh Course Links",add:"Add New Course Link",replace_link_text:"Replace Link Text",pages:"Pages",assignments:"Assignments",quizzes:"Quizzes",announcements:"Announcements",discussions:"Discussions",modules:"Modules",course_navigation:"Course Navigation",files:"Files",retrieving:"Retrieving {type}",navigation_items:"Navigation Items",placeholder:"Placeholder",no_results:"No results",a11y_insert_item:"Click to insert a link to this item"},user_detail:{title:"User Details",text_align:"Text Alignment",wrapper_align:"Wrapper Alignment",background_color:"Background Color",show_icons:"Show icons",style_studio:"User Details Style Studio",role:"Role",role_all:"All",role_teacher:"Teacher",role_ta:"TA",role_designer:"Designer",choose_role:"Choose role",users:"Users",choose_user:"Choose user",no_users_found:"no users found",no_users_found_option:"-- No Users Found --",image:"Image",change_image:"Change Image",name:"Name",email:"Email",other_1:"Other 1",other_2:"Other 2",refresh_user_list:"Refresh User List",style_card:"Card",style_inset:"Inset Label",style_overflow:"Overflow",style_box:"Box",style_legacy:"Legacy",style_square:"Square",wt_intro_title:"User Details Walkthrough",wt_intro_intro:"Use this tool to quickly add styled blocks of TA, teacher, and course designer contact information for students to reference.",wt_content_title:"Content",wt_content_intro:"<p>In the <strong>Content</strong> panel, use the controls to add a User Details block for teachers, TAs, or course designers. You can filter users by role and select the desired user from the <strong>Users</strong> dropdown. By default, contact info populates from the user's Canvas details.</p>",wt_customize_title:"Customize Contact Details",wt_customize_intro:"<p>For each contact detail, use the input area to customize the detail's text, the icon button after the input field to customize the icon that precedes the detail, and the checkbox to show or hide the detail in the Rich Content Editor.</p>",wt_refresh_title:"Refresh User List",wt_refresh_intro:"<p>Use the <strong>Refresh User List</strong> button to retrieve the most up-to-date list of users.</p>",wt_style_title:"Style",wt_style_intro:"<p>In the <strong>Style</strong> panel, you can choose the style of the user details block, change the text alignment of text within the block, and change the way other text in your content flows around the block. You can also adjust the background color and choose to show or hide the decorative icons that precede the details in the block.</p>",wt_complete_title:"User Details Walkthrough Complete",wt_complete_intro:'This completes the User Details tool walkthrough. For more detailed information about using the User Details tool, <a href="https://cidilabs.instructure.com/courses/6630/pages/user-details" target="_blank">visit the User Details User Guide article.</a> Happy course building!'},accent:{title:"Language Accent",fields_placeholder:"Accent fields go here"},lang_accent:(0,p.A)({modal_title:"Language Accents",lang_french:"French",lang_chinese_pinyin:"Chinese Pinyin",lang_german:"German",lang_g