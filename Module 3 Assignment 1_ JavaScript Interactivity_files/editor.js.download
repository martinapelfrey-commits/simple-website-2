,btn_title:"Button",fileOptions:"File Options",external:"Remove external link icon",youtube:"Remove YouTube thumbnail preview",importPage:"Replace link with imported course content (browser only)",importPageDated:"Limit link replacement to a specific date range",fileOptionDefault:"Default",fileOptionInline:"Open Inline",fileOptionDownload:"Download",courseLinks:"Course Links",linkText:"Link Text",imageAltText:"Image Alt Text",iconPickerLabel:"&nbsp; Icon",linkAccessibility:"Link Accessibility",removeLink:"Remove Link",openInNewTab:"Open in new tab",removeUnderline:"Remove underline styling",a11y_link_text_heading:"Link text:",a11y_tip_out_of_context:"should make sense out of context",a11y_tip_precise:"should be precise and to the point",a11y_tip_no_link_word:'doesn\'t need to include the word "link"',a11y_resources_heading:"Resources to learn more:",a11y_resource_webaim:"Links and Hypertext",a11y_resource_a11y_project:"Quick tip: Creating valid and accessible links",descriptiveLinkText:'<p class="my-0">Use more descriptive link text.</p>',emptyLinkText:'<p class="my-0">Enter link text. A link with no text has no name.</p>',emptyImageAlt:'<p class="my-0">Enter alt text. This image is the only content in the link, so the alt text is its name.</p>',unnecessaryLinkWord:'<p class="my-0">The word "link" is usually uneccesary, users know it\'s a link.</p>',elementId:"Element ID",advancedOptionsNotice:"Links to course pages or course content will show advanced options.",toolUnavailable:"This tool is currently unavailable.",placeholderText:"Placeholder",btn_outline:"Outline",btn_text:"Text",btn_solid:"Solid",btn_background:"BG",boxLink:"Box Link",indicateVisited:"Indicate Visited",indicateVisitedHint:"The indicator is color only. Screen readers already announce visited links.",btn_default_color:"Default Color",btn_visited:"Active",btn_hover:"Hover",clearStyles:"Clear Styles",fillWidth:"Fill Width",size_sm:"Small",size_sm_abbrev:"Sm",size_btn:"Btn",size_large:"Large",size_ful