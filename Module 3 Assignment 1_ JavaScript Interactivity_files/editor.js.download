eset:"Reset colors",color_group_history:"Undo and redo",color_theory_title:"Color Theory",color_theory_analogous:"Analogous",color_theory_complement:"Complement",color_theory_split_complement:"Split Complement",color_theory_triad:"Triad",color_theory_tetrad:"Tetrad",color_generate_from_current:"Generate from current",color_original:"Original",color_current_label:"Current",color_refresh:"Refresh Colors",color_add_favorites:"Add to Favorites",color_edit_favorites:"Edit Favorites",color_add_or_label:"Add Color or Label",color_done_favorites:"Done",color_from_content:"Colors from Content",color_from_image:"Colors from Image",image_colors_source_label:"Image source",image_colors_source_selected:"Selected image",image_colors_source_upload:"Upload",image_colors_choose_file:"Choose Image File",image_colors_extract:"Extract Colors",image_colors_no_selection:"Select an image in the editor to extract colors.",image_colors_upload_prompt:"Choose an image file to extract colors.",image_colors_no_palette:"Extract colors to see suggested swatches.",image_colors_preview_alt:"Source image preview",image_colors_extracting:"Extracting colors…",image_colors_empty:"No colors could be extracted from this image.",image_colors_fetch_error:"Could not load the selected image. Try uploading a copy of the image instead.",image_colors_extract_error:"Could not extract colors from this image.",image_colors_source_canvas:"Canvas files",image_colors_canvas_prompt:"Choose an image from Canvas files.",image_colors_canvas_list_label:"Canvas file source",image_colors_canvas_course:"Course",image_colors_canvas_user:"User",image_colors_canvas_loading:"Loading Canvas images…",image_colors_canvas_empty:"No images found in this Canvas file list.",image_colors_canvas_grid_label:"Canvas images",image_colors_canvas_error:"Could not load Canvas images. Try again later.",image_colors_palette_heading:"Suggested palette",image_colors_semantic_heading:"Semantic swatches",image_colors_swatch_vibrant:"Vibrant",image_colors_swatch_muted:"Muted",image_colors_swatch_dark_vibrant:"Dark Vibrant",image_colors_swatch_dark_muted:"Dark Muted",image_colors_swatch_light_vibrant:"Light Vibrant",image_colors_swatch_light_muted:"Light Muted",image_colors_eyedropper:"Eyedropper",image_colors_eyedropper_unsupported:"Your browser does not support the eyedropper tool.",image_colors_eyedropper_applied:"Applied {color} to the current color.",image_colors_eyedropper_error:"Could not pick a color with the eyedropper.",image_colors_extract_success_both:"Extracted {paletteCount} suggested colors and {swatchCount} semantic swatches from the image.",image_colors_extract_success_palette:"Extracted {n} suggested colors from the image.",image_colors_extract_success_semantic:"Extracted {n} semantic swatches from the image.",image_colors_add_palette_favorites:"Add suggested palette to Favorites",image_colors_add_semantic_favorites:"Add semantic swatches to Favorites",image_colors_palette_name_title:"Name suggested palette",image_colors_palette_name_prompt:"Name your suggested palette from image:",image_colors_semantic_name_title:"Name semantic swatches",image_colors_semantic_name_prompt:"Name your semantic swatches from image:",image_colors_preview_alt_named:"Preview of {name}",color_recent:"Recent Colors",color_favorites:"User Favorites",undo:"Undo",redo:"Redo",color_basic:"Basic Colors",color_basic_row:"Basic colors row {number}",color_expanded:"Expanded Colors",color_shades:"Color shades",color_palette_swatches:"Palette colors",color_family_red:"Red",color_family_pink:"Pink",color_family_purple:"Purple",color_family_deep_purple:"Deep Purple",color_family_indigo:"Indigo",color_family_blue:"Blue",color_family_light_blue:"Light Blue",color_family_cyan:"Cyan",color_family_teal:"Teal",color_family_green:"Green",color_family_light_green:"Light Green",color_family_lime:"Lime",color_family_yellow:"Yellow",color_family_amber:"Amber",color_family_orange:"Orange",color_family_deep_orange:"Deep Orange",color_family_brown:"Brown",color_family_grey:"Grey",color_family_blue_grey:"Blue Grey",color_lightness:"Lightness",color_lightness_value:"{percent}% lightness, {color}",color_add_favorite:"Add to Favorites",color_remove_favorite:"Remove from Favorites",color_try_white_text:"Try white text",color_try_black_text:"Try black text",color_edit_template_label:"Color/Label",color_swatch:"Color {hex}",group_text_align:"Text alignment",group_text_style:"Text style",group_font_size:"Font size",group_border_direction:"Border direction",group_border_size:"Border width",group_border_style:"Border style",group_border_radius:"Border radius",group_shadow:"Shadow style",group_hover_shadow:"Hover and focus shadow",group_color_type:"Color type",group_margin_direction:"Margin direction",group_margin_size:"Margin size",group_padding_direction:"Padding direction",group_padding_size:"Padding size",group_alignment:"Alignment",group_canvas_visibility:"Canvas visibility",group_print_visibility:"Print visibility",unit_px:"px",default_font_size:"Default font size",more_options:"More shadow options",save_success:"The style was saved successfully.",overwrite_title:"Overwrite style",overwrite_prompt:"The style name already exists. Would you like to overwrite it?",overwrite_yes:"Yes, overwrite",overwrite_no:"No",overwrite_cancelled:"Style was not saved.",palette_name_title:"Name palette",palette_name_prompt:"Please name your palette:",palette_name_label:"Palette name",palette_name_placeholder:"Palette name",palette_name_save:"Save palette",palette_save_success:"Palette saved to favorites.",palette_save_success_named:'Palette "{name}" saved to favorites.',common_cancel:"Cancel",common_close:"Close",color_no_favorites:"No favorites yet",color_no_recent:"No recent colors",color_palette_named:"{name} Palette",wcag_caption:"WCAG 2.2 color contrast rating",wcag_version:"WCAG 2.2",wcag_standard:"Standard",wcag_ratio:"Ratio",wcag_normal_text:"Normal text",wcag_large_text:"Large text",wcag_text_color_preview:"Text color preview",wcag_level_aa:"AA",wcag_level_aaa:"AAA",wcag_level_fail:"Fail",wcag_status:"Contrast ratio {ratio}. Normal text: {normal}. Large text: {large}.",walkthrough_title_overview:"Style Editor Walkthrough",walkthrough_intro_overview:"Use the Style Editor to make granular styling changes to content elements, to build and save quick styles for content elements, and to adjust existing quick styles.",walkthrough_title_choose_element:"Choose an Element to Edit",walkthrough_intro_choose_element:"In the <strong>node list</strong>, you can select the element you'd like to edit or apply quick styles to. Hover over a node to view its content type.",walkthrough_title_browse_quick_styles:"Browse Quick Styles",walkthrough_intro_browse_quick_styles:"If you have previously created any quick styles or your institution has made quick styles available from the Primary Customizations course, you can browse those styles in the <strong>Quick Styles</strong> panels. You can also search for quick styles by name in the <strong>Search Quick Styles</strong> field above the Quick Styles panels.",walkthrough_title_element_vs_global:"Element Styles v. Global Styles",walkthrough_intro_element_vs_global:"<p><strong>Element Quick Styles</strong> for the element you selected in the node list will appear in the top panel. These are styles that can only be applied to the selected element.</p><p><strong>Global Quick Styles</strong> appear in the next panel. These are called \"global\" styles because they can be applied to any element. When you've found the desired style, click the style's name to apply it to an element.</p>",walkthrough_title_style_controls:"Style the Selected Element",walkthrough_intro_style_controls:"Use the <strong>style controls</strong> to make granular style changes to the selected element.",walkthrough_title_text:"Style the Selected Element: Text",walkthrough_intro_text:"In the <strong>Text</strong> panel, you can update the alignment, text style, and text color of the text in the selected element.",walkthrough_title_text_detail:"Style the Selected Element: Text Continued",walkthrough_intro_text_detail:"In the <strong>Text</strong> panel, <ul><li>the <strong>text align</strong> controls adjust the text alignment of the selected element,</li><li>the <strong>text style</strong> controls apply bold, italic, or underlined styling to text,</li><li>and the <strong>text color</strong> controls apply one of your institution's branding colors to the text of the selected element. (For a wider array of colors, you'll need to use the <strong>Colors</strong> panel, which will be covered in a couple of steps.)</li></ul>",walkthrough_title_border_bg:"Style the Selected Element: Border & Background",walkthrough_intro_border_bg:"In the <strong>Border & Background</strong> panel, you can update the border attributes and basic background attributes of the selected element.",walkthrough_title_border_bg_detail:"Style the Selected Element: Border & Background Continued",walkthrough_intro_border_bg_detail:"<ul><li>The <strong>border direction</strong> controls set the border direction of the selected element,</li><li>the <strong>border radius</strong> controls set the element's border radius (in pixels),</li><li>the <strong>background color</strong> button shows options to set one of your institution's branding colors as the background color,</li><li>and the <strong>shadow</strong> controls apply a shadow to the element.</li></ul>",walkthrough_title_border_bg_direction:"Style the Selected Element: Border & Background Continued",walkthrough_intro_border_bg_direction:"Once a border direction is selected, other options also become available. <ul><li>The <strong>border width</strong> controls apply a small, medium, or large border width, or you can set a custom border width in pixels,</li><li>the <strong>border style</strong> buttons apply a border style to the selected element,</li><li>and the <strong>border color</strong> button shows options to apply one of your institution's branding colors to the element's border.</li></ul>",walkthrough_title_colors:"Style the Selected Element: Colors",walkthrough_intro_colors:"Use the <strong>Colors</strong> tool to adjust the text, background, and border colors of the selected element.",walkthrough_title_color_type:"Style the Selected Element: Color Controls",walkthrough_intro_color_type:"Use the <strong>color type</strong> controls to target the area of the element whose color you'd like to change.",walkthrough_title_current_color:"Style the Selected Element: Color Controls",walkthrough_intro_current_color:"The <strong>current color</strong> field accepts a hex code. Use the <strong>color picker</strong> button next to it to open the visual picker.",walkthrough_title_favorite_color:"Style the Selected Element: Color Controls",walkthrough_intro_favorite_color:"Use the <strong>favorite</strong> button to add the selected color to your User Favorites.",walkthrough_title_lightness_slider:"Style the Selected Element: Color Controls",walkthrough_intro_lightness_slider:"Use the <strong>color lightness slider</strong> to lighten or darken the current color.",walkthrough_title_color_theory_btn:"Style the Selected Element: Color Theory Tool",walkthrough_intro_color_theory_btn:"Need some color suggestions? Select the <strong>Related Colors</strong> button to open the <strong>Color Theory</strong> tool.",walkthrough_title_color_theory_tool:"Style the Selected Element: Color Theory Tool",walkthrough_intro_color_theory_tool:"The Color Theory tool suggests colors that will complement your current selected color, providing swatches in five common color schemes. You can apply a color from one of these schemes by clicking its swatch.",walkthrough_title_color_contrast:"Style the Selected Element: Color Contrast",walkthrough_intro_color_contrast:"Use the <strong>WCAG 2.2 Contrast Checker</strong> information to verify that your selected color meets accessible contrast ratio requirements for both normal and large text.",walkthrough_title_reset_colors:"Style the Selected Element: Reset Colors",walkthrough_intro_reset_colors:"Use the <strong>reset colors</strong> buttons to reset the current element's background color (the X button) or to reset all colors in the selected element (the eraser button).",walkthrough_title_undo_redo:"Style the Selected Element: Undo/Redo Color Changes",walkthrough_intro_undo_redo:"Use the <strong>undo and redo buttons</strong> to undo or redo your last color adjustment.",walkthrough_title_apply_favorites:"Style the Selected Element: Apply Colors from Favorites",walkthrough_intro_apply_favorites:"Any colors that you've added to your favorites will be available in the <strong>User Favorites</strong> panel. Simply select a swatch to apply it to the current element.",walkthrough_title_apply_recent:"Style the Selected Element: Apply Recent Colors",walkthrough_intro_apply_recent:"In the <strong>Recent Colors</strong> panel, you can apply colors that you've recently used.",walkthrough_title_apply_content:"Style the Selected Element: Apply Colors from Content",walkthrough_intro_apply_content:"Use the <strong>Colors from Content</strong> panel to choose colors from those found in your current page content.",walkthrough_title_customizations_palette:"Style the Selected Element: Customizations Course Color Palette",walkthrough_intro_customizations_palette:"The <strong>{label}</strong> panel contains colors that have been added to the [Color Palette] page of your institution's primary customizations course.",walkthrough_title_basic_palette:"Style the Selected Element: Basic Colors Palette",walkthrough_intro_basic_palette:"Use the <strong>Basic Colors</strong> palette to select a color from a palette of 56 swatches.",walkthrough_title_expanded_palette:"Style the Selected Element: Expanded Colors Palette",walkthrough_intro_expanded_palette:"Use the <strong>Expanded Colors</strong> palette to select a color from an even bigger palette of 190 swatches.",walkthrough_title_spacing_align:"Style the Selected Element: Spacing & Alignment",walkthrough_intro_spacing_align:"<p>Use the <strong>Spacing & Alignment</strong> controls to adjust the margins, padding, float alignment, and vertical align of the selected element.</p>",walkthrough_title_margin:"Style the Selected Element: Spacing & Alignment Continued",walkthrough_intro_margin:"<p> In the <strong>margin</strong> controls, you can set the same margin for all sides of an element by selecting <strong>All</strong> and choosing a small, medium, or large margin preset, or by entering your desired margin in pixels.</p><p>To set the margin for individual sides of the selected element, select the <strong>margin direction</strong> button. Doing so will display input fields where you can enter the desired top (T), bottom (B), left (L), and right (R) margins in pixels.</p>",walkthrough_title_padding:"Style the Selected Element: Spacing & Alignment Continued",walkthrough_intro_padding:"<p>The padding controls work much like the margin controls. You can set the same padding for all sides of an element by selecting the <strong>All</strong> button and choosing a small, medium, or large padding preset or by entering your desired padding in pixels.</p><p>To set the padding for individual sides of the selected element, select the <strong>padding direction</strong> button. Doing so will display input fields where you can enter the desired top (T), bottom (B), left (L), and right (R) padding in pixels.</p>",walkthrough_title_alignment:"Style the Selected Element: Spacing & Alignment Continued",walkthrough_intro_alignment:"The <strong>alignment</strong> controls allow you to float an element to wrap text around it.",walkthrough_title_vertical_align:"Style the Selected Element: Spacing & Alignment Continued",walkthrough_intro_vertical_align:"<p>Use <strong>Vertical align</strong> to set how the element lines up with surrounding content. Open the list to choose Default, Baseline, Top, Middle, Bottom, Text Top, or Text Bottom. Each option includes a preview of the alignment.</p>",walkthrough_title_advanced:"Style the Selected Element: Advanced",walkthrough_intro_advanced:"In the <strong>Advanced</strong> panel, you can view and manually edit the classes and inline styles for the current element. You can also copy the classes and inline styles to add them to style tables in your customizations course.",walkthrough_title_save_element:"Saving Element Quick Styles",walkthrough_intro_save_element:"Once you have customized the selected element to your liking, you can save the changes as a quick style that can be applied easily in the future. To save a quick style, enter a name for the style in the <strong>Quick Style Name</strong> field.",walkthrough_title_save_element_confirm:"Saving Element Quick Styles Continued",walkthrough_intro_save_element_confirm:"Next, select the <strong>Save Element Quick Style</strong> button to save the style. If you've already created a style with the same name, you will be asked to confirm whether you'd like to overwrite the existing style.",walkthrough_title_save_global:"Saving Global Quick Styles",walkthrough_intro_save_global:"Want to save your quick style so that it can be applied to any element? Once you save the style, a <strong>Save as Global Style</strong> button becomes available. Select it to save your quick style as a global style.",walkthrough_title_manage_styles:"Managing Quick Styles",walkthrough_intro_manage_styles:"To view a list of all of your quick styles in one place, including both element and global styles, go to the <strong>Advanced tab</strong> and open the <strong>Quick Style Manager</strong>. You can use the Quick Style Manager to share, edit, rename, and delete quick styles as well as convert any of your element styles to global styles.",walkthrough_title_complete:"Style Editor Walkthrough Complete",walkthrough_intro_complete:'This completes the Style Editor tool walkthrough. For more detailed information about using the Style Editor, <a href="https://cidilabs.instructure.com/courses/6630/pages/style-editor" target="_blank">visit the Style Editor User Guide article.</a> Happy course building!'},component:{font_allcaps_warning:"<strong>Readability warning:</strong> All-caps text is harder to scan and read, especially for people with dyslexia or other reading difficulties.",option_group:"Options",more_options:"More options",alignmentGroupLabel:"Alignment",searchTitle:"Search {searchTitle}",pageDropdown:"Filter By {searchTitle} Collection",pageDropdownDefault:"All Collections",customizationControlsHeading:"Customizations Controls",source_filter_user:"User",source_filter_course:"This Course",source_filter_shared:"Shared",source_filter_extended:"Extended",source_filter_primary:"Primary",source_named:"{label} Source",addParagraphBefore:"Add Paragraph Before",addParagraphAfter:"Add Paragraph After",heading_favorite:"Favorite {text} Tool",heading_help:"{text} Help",app_support_notice:"App Support Notice",offline_support_notice:"Offline Support Notice",close:"Close",launch_walkthrough:"Launch {text} walkthrough",walkthrough:"Walkthrough",launch_training_video:"Launch {text} training video",video:"Video",training_video:"{text} Training Video",in_development:"This tool is currently in development",in_beta:"This tool is currently in beta",flag_dev:"DEV",flag_beta:"BETA",flag_new:"NEW",flag_feat:"FEAT",a11y_clear:"Clear",a11y_current_item:"Current {item}: {contents}",a11y_move_item:"Use arrow keys to move this item up or down when this button has focus",action_item:"{action} {item}",add_label:"Add {label}",align_bottom:"Align to Bottom",align_center:"Align Center",align_default:"Default Align",align_left:"Align Left",align_middle:"Align to Middle",align_right:"Align Right",align_top:"Align to Top",apply:"Apply",apply_to_preview:"Apply to Preview",border_width:"Border {n}",color:"Color",color_accent:"accent",color_branding:"Branding",color_danger:"danger",color_dark:"dark",col