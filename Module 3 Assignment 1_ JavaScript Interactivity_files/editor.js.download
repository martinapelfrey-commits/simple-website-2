ing {0}…",workflowUntitledContent:"Untitled content",workflowUsesFound:"{0} uses found. Overwriting will update all of them.",workflowNoUsesFound:"No other uses were found in common Canvas content types.",workflowUsageScanFailed:"Image uses could not be checked. Leave overwrite unchecked to create a safe copy.",workflowReviewUses:"Review the course usage results, then select the upload action again to confirm overwrite.",workflowLoadingCurrent:"Loading current Canvas image…",workflowCurrentLoadFailed:"The current Canvas image could not be loaded for editing.",workflowOutputHeight:"Output height in pixels",workflowSizePresets:"Size presets",workflowFitContent:"Fit content width (1100px)",workflowLoadingUrl:"Loading public image for editing…",workflowUrlLoadFailed:"The public image could not be loaded for editing.",workflowSourceUpload:"Upload an Image",workflowSourceUrl:"Image from a URL",workflowSourceStock:"Free Stock Images",workflowUrlHelp:"Canvas imports the image directly. Choose Edit image first if you want to crop or resize it.",workflowCropDragHelp:"Drag inside the preview to move the crop, or use the move buttons. With the preview focused, use the arrow keys, and hold Shift for a larger step.",workflowNoImageSource:"No image source was available to load.",workflowFetchBlocked:"The image could not be loaded for editing. The image host may be blocking this request.",goToBackgroundTool:"Go to Background Tool",copying:"Copying",availableFromTo:"from {0} to {1}",availableAfter:"after {0}",availableUntil:"until {0}",toolUnavailable:"This tool is currently unavailable.",widthLabel:"Width",heightLabel:"Height",heightLockedByFigure:"Height follows the figure and cannot be set separately.",heightLockedByFullWidth:"Height follows the full-width image and cannot be set separately.",popupCheckbox:"Set image as popup when selected",popupDisableLink:"Cannot set as popup when image is inside a link",popupDisableGallery:"Image is inside a popup gallery",popupDisableSI:"Cannot set as popup when image is inside an interactive exercise",clearStyle:"Clear Style",bg_img_notice:"Use the background tool to see style options for working with background images.",anchorTop:"Top",anchorCenter:"Center",anchorBottom:"Bottom",positionGroupLabel:"Position",verticalAlignGroupLabel:"Vertical Align",verticalAlignDefault:"Default",verticalAlignBaseline:"Baseline",verticalAlignTop:"Top",verticalAlignMiddle:"Middle",verticalAlignBottom:"Bottom",verticalAlignTextTop:"Text Top",verticalAlignTextBottom:"Text Bottom",borderOptions:"Border Options",borderGroupDefault:"Default border",borderRectangle:"Rectangle",borderRounded5:"Rounded 5",borderRounded10:"Rounded 10",borderRound:"Round",borderThinBorder:"Thin Border",borderThickBorder:"Thick Border",borderPadded:"Padded",borderShadow:"Shadow",borderStyleCombined:"{0} {1}",hide_controls_notice:"Size and position controls are hidden because the image is part of a card.",sizeHeading:"Size",widthExceedsDisplay:"Set width is greater than the display size. This will apply on larger screens but image will not grow larger than the content width.",positionHeading:"Position",displayRatioHeading:"Display Ratio",anchorPointHeading:"Anchor Point",popupHeading:"Popup",captionStylesHeading:"Caption Styles",imageStyleStudio:"Image Style Studio",imageSrcLabel:"Image src",imageSrcPlaceholder:"(Set the image src URL)",imageSrcPopup:"The src attribute identifies an image by a URL. The image defined by the URL is retrieved by the browser and inserted into the content when the page loads.",imagePositionType:"Image Position Type",fitDefault:"Default",fitContain:"Contain",fitCover:"Cover",fitFill:"Fill",fitScaleDown:"Scale Down",fitNone:"None",imagePositionAnchorPoint:"Image Position Anchor Point",fitNoticeTitle:"Image Fit Type and Anchor Point Controls",fitNoticeContent:"Advanced image fit types and anchor point controls are available here for images with a display ratio applied.",imageFitTypeHeading:"Image Fit Type",imageFileDetailsHeading:"Image File Details",detailSource:"Source:",detailName:"Name:",detailSize:"Size:",detailDimensions:"Dimensions:",loading:"Loading",detailRatio:"Ratio:",detailStatus:"Status:",statusPublished:"Published",statusExternal:"External",statusUnpublished:"Unpublished",statusHidden:"Only available to students with link",retrievingDetails:"Retrieving image file details",notAvailable:"Not available",detailsLoaded:"Image file details loaded.",detailsNotFound:"Image details not found. Verify that the selected image has a valid",attributeBeforeSaving:"attribute before saving changes.",detailsNotFoundStatus:"Image details not found.",sourceUserImages:"User Images",sourceCourseImages:"Course Images",sourceSharedImages:"Shared Images",sourceExtendedImages:"Extended Images",sourcePrimaryImages:"Primary Images",sourceNamedImages:"{label} Images",imageSourceGroupLabel:"Image Sources",widthFixed:"Fixed Width",widthFill:"Fill Container Width",widthGroupLabel:"Width Style",captionStyleDefault:"Default",captionLightOverlap:"Light Overlap",captionDarkOverlap:"Dark Overlap",selected:"Selected",sizeUnitGroupLabel:"Size unit",unitPixels:"px",unitPercent:"%",noImagesFound:"No images found",imagesFound:"{0} images found",availableImages:"Available images. Use the arrow keys to move between images.",statusLimited:"Only available {0}",folderNoImages:"Folder has no images",wtIntroTitle:"Image/Image & Caption Tool Walkthrough",wtIntroText:"Use this tool to insert and style images, add important visual content or decorative images to enhance your pages, and add, edit, and choose banner images.",wtContentTitle:"Content",wtContentIntro:"<p>In the <strong>Content</strong> panel, use the controls to update an image, mark images as decorative, add or edit captions, and add a link to an image.</p>",wtChangeImageTitle:"Select an Image",wtChangeImageIntro:"<p>Use the <strong>Change Image</strong> panel at the top when you want to replace the current image. Sources and thumbnails live here; preview, optimize, and Edit appear below after you select an image.</p>",wtSearchTitle:"Search for an Image",wtSearchIntro:"<p>Use the <strong>image search</strong> field to search for images by filename in the selected source.</p>",wtSourceTitle:"Change the Image Source",wtSourceIntro:"<p>Use the <strong>image source</strong> buttons to browse user files, course files, and any available shared, extended, or primary customizations images. Available buttons depend on your account. If you use an image from outside this course, copy it to the course so all students can see it.</p>",wtFoldersTitle:"Folders/Filters",wtFoldersIntro:"<p>Use the <strong>Folders/Filters selector</strong> to search for images across multiple folders, including any images retrieved from the <strong>[Banner Images] page</strong> of customizations courses.</p>",wtRefreshTitle:"Refresh Image List",wtRefreshIntro:"<p>Use the <strong>Refresh Image List</strong> button to update the images list for the current search criteria.</p>",wtSelectTitle:"Select an Image",wtSelectIntro:"<p>Select an image thumbnail to replace the current selected image.</p>",wtDecorativeTitle:"Mark Images Decorative",wtDecorativeIntro:"<p>Use the <strong>Decorative</strong> checkbox to mark an image decorative.</p>",wtAltTextTitle:"Update Image Alt Text",wtAltTextIntro:"<p>Use the <strong>Alt Text</strong> field to describe the image for anyone who cannot see it.</p>",wtCaptionTitle:"Add an Image Caption",wtCaptionIntro:"<p>Use the <strong>Caption</strong> checkbox to add a caption to an image. Checking it displays a field for the caption and unlocks caption styles in the <strong>Style</strong> panel.</p>",wtLinkTitle:"Add a Link to an Image",wtLinkIntro:"<p>Use the <strong>Add Link</strong> button to attach a hyperlink to an image. Doing so will load the <strong>Link</strong> tool so that you can update the URL.</p>",wtStyleTitle:"Style",wtStyleIntro:"<p>The <strong>Style</strong> panel controls how the selected image looks on the page, including size, position, vertical align, display ratio, popup behavior, and borders.</p>",wtClearStyleTitle:"Clear Style",wtClearStyleIntro:"<p>Use <strong>Clear Style</strong> to remove size, position, ratio, popup, and border styles from the selected image.</p>",wtSizeTitle:"Size",wtSizeIntro:"<p>Set the image <strong>Width</strong> and <strong>Height</strong>, and choose <strong>px</strong> or <strong>%</strong> as the size unit.</p>",wtWidthStyleTitle:"Width Style",wtWidthStyleIntro:"<p>Choose <strong>Fixed Width</strong> to keep the dimensions you set, or <strong>Fill Container Width</strong> to stretch the image to the content width.</p>",wtPositionTitle:"Position",wtPositionIntro:"<p>Use the <strong>Position</strong> buttons to float the image left or right around text, center it, or clear the float.</p>",wtVerticalAlignTitle:"Vertical Align",wtVerticalAlignIntro:"<p>Use <strong>Vertical Align</strong> to set how the image lines up with surrounding text. Open the list to choose Default, Baseline, Top, Middle, Bottom, Text Top, or Text Bottom.</p>",wtRatioTitle:"Display Ratio",wtRatioIntro:"<p>Use <strong>Display Ratio</strong> to crop the image to a common aspect ratio. Applying a ratio also shows an <strong>Anchor Point</strong> control so you can choose which part of the image stays visible.</p>",wtPopupTitle:"Popup",wtPopupIntro:"<p>Check <strong>Set image as popup when selected</strong> to open a larger view of the image when a student selects it.</p>",wtCaptionStylesTitle:"Caption Styles",wtCaptionStylesIntro:"<p><strong>Caption Styles</strong> appear when the image is in a figure. Choose a default caption or a light or dark overlap style.</p>",wtBorderTitle:"Border Options",wtBorderIntro:"<p>Expand <strong>Border Options</strong> and select a border style thumbnail to apply that border to the selected image.</p>",wtAdvancedTitle:"Advanced",wtAdvancedIntro:"<p>In the <strong>Advanced</strong> panel, edit the image src URL, review file details (URL, name, size, dimensions, ratio, and status), and set object-fit or position when a display ratio is applied.</p>",wtCompleteTitle:"Image/Image & Caption Walkthrough Complete",wtCompleteIntro:'This completes the Image/Image & Caption tool walkthrough. For more detailed information about using the Image/Image & Caption tools, <a href="https://cidilabs.instructure.com/courses/6630/pages/images" target="_blank">visit the Image tool User Guide article.</a> Happy course building!',dtwSuggestedAltTextUpdated:"New suggested alt text: {text}"},img:{grid_top_left:"Top Left",grid_top_center:"Top",grid_top_right:"Top Right",grid_middle_left:"Middle Left",grid_default:"Middle Center (Default)",grid_middle_right:"Middle Right",grid_bottom_left:"Bottom Left",grid_bottom_center:"Bottom",grid_bottom_right:"Bottom Right"},icon:{title:"Icon",suggestIcons:"Suggest Icons",suggestIconsFailed:"Failed to generate icon suggestions.",daClose:"Close",daTryAgain:"Try Again",daCancel:"Cancel",daGenerating:"Generating…",daSuggestedIcons:"Suggested Icons",daOverridePrompt:"Refine results",daOverrideHint:"Provide a prompt for icon suggestions.",daSuggestionsReady:"{n} icon suggestions ready.",transparentBg:"Transparent Background",bgColor:"Background Color",borderColor:"Border Color",iconColor:"Icon Color",searchIcons:"Search icons",recentIcons:"Recent Icons",favoriteIcons:"Favorite Icons",favoriteIcon:"Favorite icon",unfavoriteIcon:"Unfavorite icon",recentFavoritesCategory:"Recent & Favorites",recentFavoritesEmpty:"No recent or favorite icons yet."},fill_in_blank:(0,p.A)({correct:"Correct",incorrect:"Incorrect",a11y_answer_bank_label:"Answer Bank",a11y_blank:"Blank",a11y_blank_answer:"Answer {answer}",a11y_blank_context:"Context: {snippet}",a11y_blank_empty:"Empty",a11y_blank_filled_with:"Filled with {answer}",a11y_blank_position:"{label} {index} of {total}",a11y_check_all_correct:"All blanks are correct.",a11y_check_empty_selection:"(empty)",a11y_check_next_steps:"Use {action} when you are ready to clear the blanks and try again.",a11y_check_wrong_blank_item:"blank {n}, you had {answer}",a11y_check_wrong_summary:"Incorrect: {detail}.",a11y_current_blank_placeholder:"(this blank)",a11y_drop_announcement:"{name} dropped into blank {pos} of {total}.",a11y_drop_zone:"Drop zone",a11y_kbd_instructions_drag:"<p><strong>Keyboard:</strong> Tab to each blank in order (and to the Check button when finished). Use the arrow keys to move between blanks. Press Space or Enter on a blank to open a chip picker, then use the arrow keys to highlight a chip and Enter to drop it. If a blank is already filled, the picker also offers a Remove option. Press Escape to close the picker without changing the blank.</p><p><strong>Mouse or touch:</strong> drag a chip from the answer bank into a blank, or click a blank to open the chip picker. Click a chip already in a blank to send it back to the bank.</p>",a11y_kbd_instructions_drag_no_check:"<p><strong>Keyboard:</strong> Tab to each blank in order. Use the arrow keys to move between blanks. Press Space or Enter on a blank to open a chip picker, then use the arrow keys to highlight a chip and Enter to drop it. If a blank is already filled, the picker also offers a Remove option. Press Escape to close the picker without changing the blank.</p><p><strong>Mouse or touch:</strong> drag a chip from the answer bank into a blank, or click a blank to open the chip picker. Click a chip already in a blank to send it back to the bank.</p>",a11y_kbd_instructions_typed:"<p><strong>Keyboard:</strong> Tab to the first blank. Type your answer, then Tab to the next blank. Use Shift + Tab to go back. When all blanks are filled, Tab to the Check button.</p><p><strong>Mouse or touch:</strong> click a blank to focus it, then type your answer.</p>",a11y_kbd_instructions_typed_no_check:"<p><strong>Keyboard:</strong> Tab to the first blank. Type your answer, then Tab to the next blank. Use Shift + Tab to go back.</p><p><strong>Mouse or touch:</strong> click a blank to focus it, then type your answer.</p>",a11y_kbd_list_description_drag:"Keyboard: Tab to each blank in order. Arrow keys move between blanks. Press Space or Enter on a blank to open a chip picker; arrow keys highlight a chip, Enter drops it. If the blank already holds a chip, the picker offers a Remove option. Escape closes the picker.",a11y_kbd_list_description_typed:"Keyboard: Tab to each blank to type an answer. Shift + Tab moves to the previous blank.",a11y_other_blank_placeholder:"(another blank)",a11y_picker_closed:"Chip picker closed.",a11y_picker_empty:"No chips remain in the answer bank.",a11y_picker_label:"Choose a chip for blank {pos} of {total}",a11y_picker_opened:"Chip picker opened. {n} options. Use arrow keys to choose, Enter to confirm, Escape to cancel.",a11y_picker_opened_empty:"Chip picker opened. No chips available. Press Escape to close.",a11y_picker_remove:"Remove {name} (return to answer bank)",a11y_picker_removed:"{name} removed from blank {pos} of {total} and returned to the answer bank.",a11y_returned_to_bank:"{name} returned to the answer bank.",a11y_solution_shown:"Solution shown. The correct answer is filled in for each blank.",a11y_start_belt_region:"How to fill in the blanks in this activity",a11y_unnamed_chip:"Chip",post_check_guidance_drag:"You cannot move chips until you select {action}. {action} returns the chips to the answer bank in a new order so you can practice again.",post_check_guidance_typed:"You cannot edit your answers until you select {action}. {action} clears the blanks so you can practice again."},{answer_n:"Answer {n}",answers:"Answers",background_color:"Background Color",blank:"Blank",distractor:"Distractor",distractor_n:"Distractor {n}",distractors:"Distractors",horizontal_layout:"Horizontal Layout",layout:"Layout",make_answers_draggable:"Make Answers Draggable",placeholder_text:"Placeholder text",style_studio:"Fill-in-the-Blank Style Studio",title:"Fill-in-the-Blank",vertical_layout:"Vertical Layout",input_prompt:"Describe a topic for a fill-in-the-blank activity.",refine_input_placeholder:"What would you like to change?",heading_text:"Fill-in-the-Blank Generator",apply_button_label:"Add Fill-in-the-Blank",select_words:"Select Words to Blank",select_distractors:"Select Distractors",wt_accept_misspellings_intro:'Allow small spelling mistakes to count as correct answers. This option is available only when "Make Answers Draggable" is not selected.',wt_accept_misspellings_title:"Accept minor misspellings",wt_add_blank_intro:"Add a new blank answer space at the cursor position. If the input type is draggable, you may also add distractor answers here.",wt_add_blank_title:"Add Blank",wt_advanced_intro:"Customize module progress behavior for pages that contain student interactives.",wt_advanced_title:"Advanced",wt_answer_options_intro:"Edit the text of the answers. Use the delete button to remove an answer.  If the input type is draggable, you may also edit any distractor answers here.",wt_answer_options_title:"Answer Options",wt_complete_intro:'This completes the Fill-in-the-Blank tool walkthrough. For more information about the Fill-in-the-Blank tool, visit the <a href="https://cidilabs.instructure.com/courses/6630/pages/fill-in-the-blanks" target="_blank">Fill-in-the-Blank tool User Guide article.</a>',wt_complete_title:"Fill-in-the-Blank Walkthrough Complete",wt_controls_corners_intro:"Change the roundedness of the fill-in-the-blank controls or outline.",wt_controls_corners_title:"Controls Corners",wt_controls_outline_intro:"When enabled, this adds an outline to the entire fill-in-the-blank and controls area.",wt_controls_outline_title:"Controls Outline",wt_data_tracking_intro:"Set the title that is used to identify this interactive exercise in the Interactive Data tool.  This title is not visible to students.",wt_data_tracking_title:"Data Tracking Title",wt_disable_data_tracking_intro:"Choose not to track data when students submit their answers.  This interactive will not be included in the Interactive Data tool.",wt_disable_data_tracking_title:"Disable data tracking for this interactive",wt_feedback_correct_intro:"Choose to add an optional Feedback field that will appear when students check their answers and are 100% correct. You can type feedback, utilize links, include emojis, images, videos, etc.",wt_feedback_correct_title:"Show feedback when 100% correct",wt_feedback_incorrect_intro:"Choose to add an optional Feedback field that will appear when students check their answers and discover they were incorrect. You can type feedback, utilize links, include emojis, images, videos, etc.",wt_feedback_incorrect_title:"Show feedback when incorrect",wt_hide_controls_intro:"When enabled, the controls are hidden so that this interactive cannot be scored. ",wt_hide_controls_title:"Hide Controls",wt_hide_next_intro:"Select this checkbox to prevent students from advancing to the next module item until all student interactives are answered correctly.",wt_hide_next_message_intro:"Enter the message you'd like to display to students when they attempt to advance to the next module item without answering all student interactives correctly.",wt_hide_next_message_title:"Customize the Hide Next Message",wt_hide_next_title:"Hide the Canvas Next Button",wt_hide_solution_intro:"When enabled, this does not show the solution button to students after checking their answer.",wt_hide_solution_title:"Hide Solution",wt_hide_timer_intro:"When enabled, the timer is hidden from students.",wt_hide_timer_title:"Hide Timer",wt_input_type_intro:"When enabled, answers are displayed in an answer bank below the text for students to match to the correct blanks. When disabled, students must type their responses directly into each blank. All typed responses are case sensitive.",wt_input_type_title:"Input Type",wt_intro_text:"Use this tool to create interactive fill-in-the-blank questionnaires or forms.",wt_intro_title:"Fill-in-the-Blank Walkthrough",wt_preview_intro:"The Preview section gives you an interactive view of the rendered fill-in-the-blank.",wt_preview_title:"Preview",wt_style_intro:"When the type is draggable, the Style panel has options to change answer background color and layout (horizontal or vertical).",wt_style_title:"Style"}),color_picker:{dialog_title:"Choose color",remove_color:"Remove color",transparent_background:"Transparent Background",section_branding:"Branding",section_highlight:"Highlight",section_legacy_alerts:"Legacy / Alerts",section_misc:"Misc",color_type_background:"background",color_type_text:"text",color_type_border:"border",a11y_swatch:"{name} {type}",a11y_trigger_selected:"Selected: {selection}",a11y_trigger_none:"No color selected",a11y_custom_color:"Color {hex}",color_dp_primary:"Institution Primary",color_dp_secondary:"Institution Secondary",color_dp_accent:"Institution Accent",color_dp_gray:"Gray",color_dp_white:"White",color_hl_yellow:"Highlight Yellow",color_hl_orange:"Highlight Orange",color_hl_red:"Highlight Red",color_hl_blue:"Highlight Blue",color_hl_green:"Highlight Green",color_lg_tip:"Legacy Tip",color_lg_info:"Legacy Info",color_lg_success:"Legacy Success",color_lg_warning:"Legacy Warning",color_lg_danger:"Legacy Danger",color_lt_primary:"Primary Alert",color_lt_secondary:"Secondary Alert",color_lt_success:"Success Alert",color_lt_danger:"Danger Alert",color_lt_warning:"Warning Alert",color_lt_info:"Info Alert",color_lt_light:"Light Alert",color_lt_dark:"Dark Alert",color_primary:"Primary",color_secondary:"Secondary",color_success:"Success",color_danger:"Danger",color_warning:"Warning",color_info:"Info",color_light:"Light",color_mid:"Mid",color_dark:"Dark"},flashcards:(0,p.A)({input_correct:"Correct!",input_placeholder:"Your answer",post_check_guidance_input:"You cannot edit checked cards until you select {action}. {action} clears your answers so you can practice again.",a11y_card_correct:"{card}: Correct.",a11y_card_incorrect:"{card}: Incorrect.",a11y_card_label:"Card {n} of {total}",a11y_card_position:"Card {current} of {total}",a11y_check_all_correct:"All cards are correct.",a11y_check_next_steps:"Use {action} when you are ready to practice again.",a11y_check_wrong_cards:"Incorrect: {list}. Feedback is shown on each card you checked.",a11y_correct_answer:"Correct answer: {answer}.",a11y_deck_region:"Flashcard deck",a11y_flip_card:"Flashcard: {card}",a11y_flip_sides_announcement:"All cards now show the {side} side.",a11y_incorrect_correct_answer:"Incorrect. Correct answer: {answer}.",a11y_kbd_instructions_flip:"<p><strong>Keyboard:</strong> Tab to Previous or Next to move between cards. Tab to the flip control on a card to show the other side. Use Flip Sides in the controls to flip every card at once when available.</p><p><strong>Mouse or touch:</strong> select Previous or Next, or click a card to flip it.</p>",a11y_kbd_instructions_input:"<p><strong>Keyboard:</strong> Tab to Previous or Next to move between cards. Type your answer, press Enter or the Check button to check. After checking, use Next to continue. Complete all cards to finish the activity. When you are finished, Tab to Try Again or Reset.</p><p><strong>Mouse or touch:</strong> use Previous and Next, type your answer, then select Check for each card.</p>",a11y_kbd_instructions_self_check:"<p><strong>Keyboard:</strong> Tab to Previous, the flip control, Correct or Incorrect, then Next to move through each card. Use the card progress buttons to jump to a card.</p><p><strong>Mouse or touch:</strong> use Previous and Next, or select a card in the progress row, then mark Correct or Incorrect.</p>",a11y_kbd_list_description_flip:"Keyboard: Tab to Previous or Next. Tab to the flip button on the active card to turn it over.",a11y_kbd_list_description_input:"Keyboard: Tab to Previous or Next to change cards. Enter your answer, press Enter or the Check button to check. After checking, use Next to continue. Complete all cards to finish the activity. Try Again or Reset clears your work.",a11y_kbd_list_description_self_check:"Keyboard: Tab to Previous, flip, Correct or Incorrect, then Next. Progress buttons jump to a card.",a11y_mark_correct:"Mark this card correct",a11y_mark_incorrect:"Mark this card incorrect",a11y_nav_at_first:"At first card.",a11y_nav_at_last:"At last card.",a11y_next:"Next card",a11y_previous:"Previous card",a11y_progress_nav:"Card progress",a11y_self_check_rate_group:"Mark this card",a11y_shuffle_announcement:"Cards shuffled. {card}.",a11y_side_back:"back",a11y_side_front:"front",a11y_skip_nav_next:"Skip flashcard navigation",a11y_skip_nav_prev:"Skip flashcard navigation",a11y_start_belt_region:"How to complete this flashcard activity"},{title:"Flashcards",flashcards:"Flashcards",add_flashcard:"Add Flashcard",remove_flashcard:"Remove Flashcard",background_color:"Background Color",font_style:"Font Style",default:"Default",shuffle:"Shuffle",term:"Term",description:"Description",none:"None",self_check:"Self-Check",input_check:"Input Check",hide_flip_sides:"Hide the flip sides button from students",hide_shuffle_button:"Hide the shuffle button from students",card_order:"Card Order",visible_side:"Visible Side",check_answers:"Check Answers",style_studio:"Flashcards Style Studio",instructions:"Instructions",term_n:"Flashcard Term {n}",description_n:"Flashcard Description {n}",default_content:"Content",empty_flashcard_n:"[Empty Flashcard {n}]",input_prompt:"Enter a topic or comma separated list of terms.",refine_input_placeholder:"What would you like to change?",heading_text:"Flashcards Generator",apply_button_label:"Add Flashcards",wt_accept_misspellings_intro:"Allow small spelling mistakes to count as correct when students use Input Check. This setting is hidden for None and Self-Check modes.",wt_accept_misspellings_title:"Accept minor misspellings",wt_advanced_intro:"Configure the settings of the flashcards.",wt_advanced_title:"Advanced Options",wt_background_color_intro:"Change the background color of the flashcards set area.",wt_background_color_title:"Background Color",wt_check_answers_intro:"<p><strong>None:</strong> Flashcards function as simple flip cards for students to review terms and definitions without a built-in way to track answers.</p>\n                    <p><strong>Self-Check:</strong> Students can mark whether they got the answer right or wrong after viewing the card, allowing for self-assessment.</p>\n                    <p><strong>Input Check:</strong> Instead of flipping the card, students type in their answer. The system then checks their response for accuracy.</p>",wt_check_answers_title:"Check Answers",wt_complete_intro:'This completes the Flashcards tool walkthrough. For more information about the Flashcards tool, visit the <a href="https://cidilabs.instructure.com/courses/6630/pages/flashcards" target="_blank">Flashcards tool User Guide article.</a>  It\'s flippin\' awesome!',wt_complete_title:"Flashcards Walkthrough Complete",wt_controls_corners_intro:"Change the roundedness of the flashcards controls or outline.",wt_controls_corners_title:"Controls Corners",wt_controls_intro:"Use the handle to reorder flashcards, the input to rename the flashcard term, the clear button to remove the term text, or the delete button to remove the flashcard.  The flashcard description can only be edited in the RCE.",wt_controls_outline_intro:"When enabled, this adds an outline to the entire flashcards and controls area.",wt_controls_outline_title:"Controls Outline",wt_controls_title:"Flashcard Controls",wt_data_tracking_intro:"Set the title that is used to identify this interactive exercise in the Interactive Data tool.  This title is not visible to students.",wt_data_tracking_title:"Data Tracking Title",wt_disable_data_tracking_intro:"Choose not to track data when students submit their answers.  This interactive will not be included in the Interactive Data tool.",wt_disable_data_tracking_title:"Disable data tracking for this interactive",wt_feedback_correct_intro:"Choose to add an optional Feedback field that will appear when students check their answers and are 100% correct. You can type feedback, utilize links, include emojis, images, videos, etc.",wt_feedback_correct_title:"Show feedback when 100% correct",wt_feedback_incorrect_intro:"Choose to add an optional Feedback field that will appear when students check their answers and discover they were incorrect. You can type feedback, utilize links, include emojis, images, videos, etc.",wt_feedback_incorrect_title:"Show feedback when incorrect",wt_flip_sides_intro:"Decide if the flashcards show the front term or the back description when loaded.",wt_flip_sides_title:"Flip Sides",wt_font_list_intro:"Change the font style of the flashcards.",wt_font_list_title:"Font List",wt_hide_controls_intro:"When enabled, the controls are hidden so that this interactive cannot be scored. ",wt_hide_controls_title:"Hide Controls",wt_hide_flip_intro:"Disable students' ability to change the visible side.",wt_hide_flip_title:"Hide Flip",wt_hide_next_intro:"Select this checkbox to prevent students from advancing to the next module item until all student interactives are answered correctly.",wt_hide_next_message_intro:"Enter the message you'd like to display to students when they attempt to advance to the next module item without answering all student interactives correctly.",wt_hide_next_message_title:"Customize the Hide Next Message",wt_hide_next_title:"Hide the Canvas Next Button",wt_hide_shuffle_intro:"Disable students' ability to shuffle the card order after the initial load.",wt_hide_shuffle_title:"Hide Shuffle",wt_hide_solution_intro:"When enabled, this does not show the solution button to students after checking their answer.",wt_hide_solution_title:"Hide Solution",wt_hide_timer_intro:"When enabled, the timer is hidden from students.",wt_hide_timer_title:"Hide Timer",wt_intro_text:"Use this tool to create sets of interactive cards that use animation when selected.",wt_intro_title:"Flashcards Walkthrough",wt_number_intro:"Use the input field to quickly add or remove flashcards from the set, or use the buttons to makes changes one flashcard at a time.",wt_number_title:"Flashcards Number",wt_preview_intro:"The Preview section gives you an interactive view of the rendered flashcard set where you can see styles and advanced options at work.",wt_preview_title:"Preview",wt_shuffle_intro:"Decide if the flashcards load for students in the default order that you create them in the RCE, or if they load shuffled.",wt_shuffle_title:"Shuffle",wt_style_intro:"Change the style of the flashcards.",wt_style_title:"Style"}),flip_cards:{title:"Flip Cards",editor_visibility:"Editor Visibility",new_item:"New Item",front_card:"Front Card",back_card:"Back Card",add_components:"Add Components",front_card_contents:"Front Card Contents",back_card_contents:"Back Card Contents",visibility:"Visibility",front:"Front",back:"Back",both:"Both",header:"Header",image:"Image",body:"Body",list:"List",link_list:"Link List",footer:"Footer",contents:"Contents",contents_n:"Contents {n}",add_front_components:"Add Front Components",add_back_components:"Add Back Components",front_background_color:"Front Background Color",back_background_color:"Back Background Color",front_body_align:"Front Body Align",back_body_align:"Back Body Align",overall_card_style:"Overall Card Style",front_card_style:"Front Card Style",back_card_style:"Back Card Style",front_text_align:"Front Text Align",back_text_align:"Back Text Align",width:"Width",height:"Height",position:"Position",border_radius:"Border Radius",card_border_radius:"Card Border Radius",card_shadow:"Card Shadow",width_small:"300px (default)",width_medium:"400px",width_large:"500px",height_auto:"Auto (default)",height_small:"200px",height_medium:"300px",height_large:"400px",default:"Default",none:"None",small:"Small",medium:"Medium",large:"Large",flip_card:"Flip Card",card_header:"Card Header",card_body_title:"Card Body Title",card_body_text:"Card Body Text",card_body_text_p:"Card Body Text.",card_image_alt:"card image placeholder",item_first:"An item",item_second:"A second item",item_third:"A third item",placeholder:"Placeholder",card_footer:"Card footer",wt_intro_title:"Flip Card Walkthrough",wt_intro_text:"You can use the Flip Cards tool to create interactive cards that use animation when selected.  Flip cards can promote student engagement with content.",wt_visibility_title:"Editor Visibility",wt_visibility_intro:"You can control the visibility of the current flip card while editing.  By default, both sides are visible.  However, you can choose just front or back visibility so you can better see how the card fits in the content.",wt_front_controls_title:"Front Card Controls",wt_front_controls_intro:"All of the controls in this panel apply to the content on the front of the flip card.",wt_add_components_title:"Add Components",wt_add_components_intro:"Click a button to add a component to the card.  Options include: Header (automatically added to the top of the card), Image, Body, List, Link List, and Footer (automatically added to the bottom of the card).",wt_card_contents_title:"Card Contents",wt_card_contents_intro:"This is a list of all the items in the card.  You can use the handle on the left side to drag and drop items to reorder them.  Also, there is a duplicate and delete button on the right side of each item.",wt_back_controls_title:"Back Card Controls",wt_back_controls_intro:"All of the controls in this panel apply to the content on the back of the flip card.  The controls are the same as the front card controls.",wt_style_title:"Style",wt_style_intro:"This panel has many controls to style the flip card.  You can change the background color, border radius, card shadow, and more.",wt_overall_style_title:"Overall Card Style",wt_overall_style_intro:"The controls in this panel apply styles to both sides of the flip card.",wt_width_title:"Width",wt_width_intro:"Set the width of the flip card to small (300px - default), medium (400px), or large (500px).",wt_height_title:"Height",wt_height_intro:"Set the height of the flip card to auto fill (default), small (200px), medium (300px), or large (400px).  Auto fill will make sure the card height fits the content from the taller side.  Small, medium, or large will set a fixed height and provide a scroll bar if the content exceeds that height.",wt_position_title:"Position",wt_position_intro:"Float the card left or right, or center it on the page.",wt_border_radius_title:"Border Radius",wt_border_radius_intro:"Adjust the roundedness of the corners of the flip card.",wt_card_shadow_title:"Card Shadow",wt_card_shadow_intro:"Apply a shadow style around the card edges.",wt_front_style_title:"Front Card Style",wt_front_style_intro:"The controls in this panel apply styles to only the front of the flip card.",wt_background_color_title:"Background Color",wt_background_color_intro:"Select a background color for the front side of the card.  This can help your cards really pop!",wt_text_align_title:"Text Align",wt_text_align_intro:"Align the text inside the card left, center, or right.",wt_body_align_title:"Body Align",wt_body_align_intro:"Align the card body top, middle, or bottom.  This only applies if the height of the card is greater than the height of the content.",wt_back_style_title:"Back Card Style",wt_back_style_intro:"The controls in this panel apply styles to only the back of the flip card.  All of the style controls are the same as the front card style controls.",wt_preview_title:"Preview",wt_preview_intro:"This panel will render an interactive preview for you to see how the flip card will look for students.",wt_complete_title:"Flip Cards Walkthrough Complete",wt_complete_intro:'This completes the Flip Cards tool walkthrough. For more information about the Flip Cards tool, visit the <a href="https://cidilabs.instructure.com/courses/6630/pages/flip-cards" target="_blank">Flip Cards tool User Guide article.</a>  It\'s flippin\' awesome!'},quick_check:(0,p.A)(h.A,{title:"Quick Check",set_correct:"Set as correct answer",set_incorrect:"Set as incorrect answer",no_border:"Remove default border",multiple_answers:"Enable checkboxes for multiple answers",interactive:"Enable interactive controls",shuffle_answers:"Shuffle answers",input_prompt:"Enter a topic or question from which to generate a multiple choice quick check.",refine_input_placeholder:"What would you like to change?",heading_text:"Quick Check Generator",apply_button_label:"Add Quick Check",count_label:"Number of answers"}),match_items:(0,p.A)({default_left_label:"Items",default_right_label:"Matches",matched_items_heading:"Matched Items",correct:"Correct",incorrect:"Incorrect",a11y_all_matched_checking:"All pairs matched. Checking answers.",a11y_all_matched_short:"All pairs matched.",a11y_check_complete_short:"Check complete.",a11y_check_summary:"Check complete. {correct} of {total} pairs correct.",a11y_correct_match_pair:"Correct match. {term} with {match}.",a11y_correct_short:"Correct match.",a11y_incorrect_match:"Incorrect match. Try again.",a11y_incorrect_short:"Incorrect match.",a11y_kbd_columns_note:" After the first selection, focus moves to the other column.",a11y_kbd_instructions_delay:"<p><strong>Keyboard:</strong> Tab to the first item, then use arrow keys to move. Press Space or Enter to select items for a pair. Matched pairs appear below with an Undo button. Escape clears a partial selection. When all pairs are built, Tab to Check.</p><p><strong>Mouse or touch:</strong> click two items to pair them, then select Check.</p>",a11y_kbd_instructions_delay_no_check:"<p><strong>Keyboard:</strong> Tab to items, arrow keys to move, Space or Enter to select pairs. Undo removes a staged pair. Escape clears selection.</p>",a11y_kbd_instructions_memory:"<p><strong>Keyboard:</strong> Tab to the card grid, then use arrow keys to move between cards. Press Space or Enter to flip a card and select it for a pair. Select two cards, then Tab to Check when finished.</p><p><strong>Mouse or touch:</strong> tap a card to flip and select it, then select its match.</p>",a11y_kbd_instructions_memory_no_check:"<p><strong>Keyboard:</strong> Tab to the card grid, then use arrow keys between cards. Press Space or Enter to flip and select. Select two cards.</p><p><strong>Mouse or touch:</strong> tap cards to flip and select pairs.</p>",a11y_kbd_instructions_pairing:"<p><strong>Keyboard:</strong> Tab to the first item, then use arrow keys to move. Press Space or Enter to select two matching items. Escape clears a partial selection. When finished, Tab to Check.</p><p><strong>Mouse or touch:</strong> click two items that belong together.</p>",a11y_kbd_instructions_pairing_no_check:"<p><strong>Keyboard:</strong> Tab to items, arrow keys to move, Space or Enter to select two matches. Escape clears selection.</p>",a11y_kbd_list_delay:"Keyboard: Arrow keys move between items. Space or Enter selects pairs. Escape clears selection. Undo reverses a staged pair.",a11y_kbd_list_memory:"Keyboard: Arrow keys move between cards. Space or Enter flips and selects. Select two cards.",a11y_kbd_list_pairing:"Keyboard: Arrow keys move between items. Space or Enter selects. Escape clears selection.",a11y_list_delay:"Items to match. Select two, then check answers.",a11y_list_memory:"Memory cards",a11y_list_pairing:"Items to match. Select two that go together.",a11y_matched_pairs_list:"Matched pairs",a11y_memory_face_down:"Card {n}, face down",a11y_memory_match_face_down:"Match {n}, face down",a11y_memory_revealed:"{name} revealed.",a11y_memory_term_face_down:"Term {n}, face down",a11y_pair_staged:"Pair added: {term} with {match}. {remaining} pairs left to build.",a11y_pair_undone:"Pair removed. Items returned to the list.",a11y_role_definition:"Match",a11y_role_term:"Term",a11y_selected:"{name} selected.",a11y_selected_one:"{name} selected. Select a second item.",a11y_selection_cleared:"Selection cleared.",a11y_staged_short:"Pair added.",a11y_start_belt_region:"How to complete this match activity",a11y_state_selected:"selected",a11y_undo_pair:"Undo match: {term} and {match}",a11y_unnamed_item:"Item",a11y_unselected:"{name} not selected."},{title:"Match Items",activity_type:"Activity Type",item_type:"Item Type",delay_feedback:"Disable immediate correct/incorrect indicators",alignment:"Image Text Alignment",background_color:"Background Color",match_instructions:"Select each set of two matching items."}),sort:(0,p.A)({answer_bank_heading:"Answer Bank",correct_text:"Correct",incorrect_text:"Incorrect",item_sr_label:"Draggable Item",a11y_answer_bank_arrows:"Item in answer bank. Use Down or Right to move to the first category.",a11y_check_all_correct:"All items are in the correct category.",a11y_check_next_steps:"Use {action} when you are ready to shuffle the answer bank again.",a11y_check_wrong_count:"{n} items are in the wrong category. Each item states Correct or Incorrect.",a11y_focus_bank_after_drop:"Focus moved to the answer bank.",a11y_focus_bank_via_shortcut:"Answer bank.",a11y_item_in_category:"Item in category: {name}.",a11y_item_picked:"Picked up {name}.",a11y_item_released:"Released card.",a11y_item_result_label:"{name}. {state}.",a11y_kbd_instructions:"<p><strong>Keyboard:</strong> Tab to the first card, then use the arrow keys to move between cards. Press Space or Enter to pick up a card; while it is picked up, Down or Right moves to the next category (Up or Left for the previous). Press Space or Enter again to drop, or Escape to cancel. You can also Tab to a category list and press Space or Enter to drop.</p><p><strong>Mouse or touch:</strong> drag cards into categories, or click a card to select it and then click a category to drop.</p>",a11y_kbd_instructions_no_check:"<p><strong>Keyboard:</strong> Tab to the first card, then use the arrow keys to move between cards. Press Space or Enter to pick up a card; while it is picked up, Down or Right moves to the next category (Up or Left for the previous). Press Space or Enter again to drop, or Escape to cancel. You can also Tab to a category list and press Space or Enter to drop.</p><p><strong>Mouse or touch:</strong> drag cards into categories, or click a card to select it and then click a category to drop.</p>",a11y_kbd_list_description:"Keyboard: Tab to the first card. Arrow keys move between cards. Space or Enter picks up or releases; while picked up, Down or Right moves to the next category, Up or Left to the previous. Escape cancels pickup.",a11y_kbd_list_description_focus_bank:" Alt+Shift+B moves focus to the answer bank.",a11y_kbd_shortcut_focus_bank:"Alt+Shift+B moves focus to the answer bank.",a11y_pickup_first:"Select a card first, or use the keyboard on a card in this list.",a11y_pref_focus_bank_label:"After dropping a card, move keyboard focus to the answer bank.",a11y_shortcut_word:"Shortcut",a11y_start_belt_region:"How to sort items in this activity",post_check_guidance:"You cannot move cards until you select {action}. {action} returns all cards to the answer bank in a new random order so you can practice again."},{title:"Sort Items",bucket:"Bucket",item:"Item",level_controls:"Level to edit",pool:"Pool",alignment:"Image Text Alignment",text_location:"Image Text Location",input_prompt:"Describe a topic for a sortable activity.",refine_input_placeholder:"What would you like to change?",heading_text:"Sort Items Generator",apply_button_label:"Build Activity"}),order:(0,p.A)({correct:"Correct",incorrect:"Incorrect",a11y_check_all_correct:"All items are in the correct order.",a11y_check_next_steps:"Use {action} when you are ready to shuffle and practice again.",a11y_check_wrong_count:"{n} item or items are in the wrong position. Each item states Correct or Incorrect.",a11y_item_picked:"Picked up {name}. Position {position} of {total}. Use arrow keys to move, then Space or Enter to release.",a11y_item_placed:"{name} placed. Use Space or Enter to pick up another item.",a11y_item_released:"Released item.",a11y_item_result_label:"{name}. {state}.",a11y_item_unnamed:"Item",a11y_kbd_instructions:"<p><strong>Keyboard:</strong> Tab to the first item, then use the arrow keys to move between items (Up and Down, or Left and Right in horizontal layouts). Press Space or Enter to pick up an item; while it is picked up, use the same arrow keys to move it, then press Space or Enter again to release. When you are finished, Tab to the Check button.</p><p><strong>Mouse or touch:</strong> click an item to pick it up, then drag and drop or click where it should go.</p>",a11y_kbd_instructions_no_check:"<p><strong>Keyboard:</strong> Tab to the first item, then use the arrow keys to move between items (Up and Down, or Left and Right in horizontal layouts). Press Space or Enter to pick up an item; while it is picked up, use the same arrow keys to move it, then press Space or Enter again to release.</p><p><strong>Mouse or touch:</strong> click an item to pick it up, then drag and drop or click where it should go.</p>",a11y_kbd_list_description:"Keyboard: Tab to the first item. Arrow keys move between items. Space or Enter picks up or releases the focused item; while picked up, arrow keys move it. Escape cancels pickup.",a11y_list_end:"End of list.",a11y_list_start:"Start of list.",a11y_listbox_label:"Reorder the items into the correct sequence",a11y_moved_toward_end:"Moved toward the end. Now in position {position} of {total}.",a11y_moved_toward_start:"Moved toward the start. Now in position {position} of {total}.",a11y_start_belt_region:"How to reorder items in this activity",post_check_guidance:"You cannot reorder items until you select {action}. {action} shuffles the list so you can practice again."},{title:"Order Items",layout:"Layout",alignment:"Image Text Alignment",background_color:"Background Color",image_ratio:"Image Ratio",input_prompt:"Describe a topic for an ordering activity.",refine_input_placeholder:"What would you like to change?",heading_text:"Order Items Generator",apply_button_label:"Add Order Items"}),select_all:(0,p.A)({correct:"Correct",incorrect:"Incorrect",a11y_check_all_correct:"All correct items are selected.",a11y_check_next_steps:"Use {action} when you are ready to clear your selections and try again.",a11y_check_wrong_item:"{name}",a11y_check_wrong_summary:"Incorrect selections: {detail}.",a11y_kbd_instructions:"<p><strong>Keyboard:</strong> Tab to the first choice, then use the arrow keys to move between choices. Press Space or Enter to select or deselect each choice. When you are finished, Tab to the Check button.</p><p><strong>Mouse or touch:</strong> click a choice to select or deselect it.</p>",a11y_kbd_instructions_no_check:"<p><strong>Keyboard:</strong> Tab to the first choice, then use the arrow keys to move between choices. Press Space or Enter to select or deselect each choice.</p><p><strong>Mouse or touch:</strong> click a choice to select or deselect it.</p>",a11y_kbd_list_description:"Keyboard: Tab to the first choice. Arrow keys move between choices. Space or Enter toggles selection.",a11y_list_label:"Select all correct items",a11y_missed_correct:"Correct. Not selected.",a11y_selected:"{name} selected.",a11y_solution_missed_intro:"Correct answers you did not select: {detail}.",a11y_solution_missed_item:"{name}",a11y_solution_shown:"Solution shown. Each item is marked correct or incorrect.",a11y_start_belt_region:"How to complete this select-all activity",a11y_unnamed_option:"Item",a11y_unselected:"{name} not selected.",post_check_guidance:"You cannot change your selections until you select {action}. {action} clears your choices and shuffles the list so you can practice again."},{title:"Select All",alignment:"Text Alignment",background_color:"Background Color"}),poll:(0,p.A)({submit:"Submit",view_results:"View Results",hide_results:"Hide Results",submit_another:"Change my response",submit_unavailable:"Mobile app users and unauthenticated users cannot submit polls",answer_label:"Your response",char_count:"{n} characters left",notice_markup:"HTML tags cannot be submitted. Type your response as plain text.",completion_default:"Thank you for your response.",responded_at:"Submitted {date} at {time}",instructions_multi:"Choose up to {n}, then submit.",instructions_resubmit:"You can change your response later.",results_heading:"Results",results_total_one:"{n} responses",results_total_multi:"{n} responses, each choosing up to {max}",result_count_one:"{n} response",result_count_other:"{n} responses",pending_floor:"Results appear once at least {n} students have responded, so no one can be identified from a small set of answers.",pending_date:"Results will be available after {date}.",pending_count:"Results will be available after {n} responses.",a11y_kbd_instructions_one:"<p><strong>Keyboard:</strong> Tab to the first choice, then use the arrow keys to move between choices. Press Space or Enter to select one choice. When you are finished, Tab to the Submit button.</p><p><strong>Mouse or touch:</strong> click a choice, then select Submit.</p>",a11y_kbd_instructions_multi:"<p><strong>Keyboard:</strong> Tab to the first choice, then use the arrow keys to move between choices. Press Space or Enter to select or deselect each choice. When you are finished, Tab to the Submit button.</p><p><strong>Mouse or touch:</strong> click a choice to select or deselect it, then select Submit.</p>",a11y_kbd_instructions_input:"<p><strong>Keyboard:</strong> Tab to the response field and type a short answer. When you are finished, Tab to the Submit button.</p><p><strong>Mouse or touch:</strong> type a short response, then select Submit.</p>",a11y_kbd_instructions_radio:"<p><strong>Keyboard:</strong> Tab to the choices. Use the arrow keys to move between choices and select one. When you are finished, Tab to the Submit button.</p><p><strong>Mouse or touch:</strong> click a choice, then select Submit.</p>",a11y_kbd_instructions_checkbox:"<p><strong>Keyboard:</strong> Tab to each choice. Press Space to select or clear a choice. When you are finished, Tab to the Submit button.</p><p><strong>Mouse or touch:</strong> click a choice to select or clear it, then select Submit.</p>",a11y_group_name:"Poll",a11y_unnamed_option:"Item",a11y_selected:"{name} selected.",a11y_unselected:"{name} not selected.",a11y_limit_reached:"Limit reached. You can choose up to {n}. Clear a selection first.",a11y_not_submitted:"Response not submitted. {reason}",a11y_results_shown:"Results shown.",a11y_results_hidden:"Results hidden.",selection_count:"{n} of {max} chosen"},{title:"Poll",response_style:"Response Style",style_text:"Text",style_image:"Image",style_figure:"Image and Caption",style_input:"Short Text",selections:"Selections",one_choice:"One Choice",multiple:"Multiple",items:"Items:",limit:"Choose up to:",new_item:"New Item",choice_item:"Item {n}",choice_name:"Name for Item {n}",input_notice:"Free-text responses are limited to 300 characters and have no results chart.",show_results:"Show results to students",reveal:"When students can see results",reveal_immediate:"Immediately",reveal_date:"After a Date",reveal_threshold:"After N Responses",reveal_date_label:"Results available after",reveal_count_label:"Responses required",floor_notice:"Results are always withheld until at least 5 students have responded, whichever timing you choose.",resubmit:"Allow students to change response",hide_submission:"Hide submission",alignment:"Text Alignment",background_color:"Background Color",bar_color:"Results Bar Color",style_studio:"Poll List Style Studio",responses_notice_one:"1 response has already been submitted for this poll, so be careful about editing it. If you need to make any significant changes, you may want to consider resetting the data or duplicating this poll instead.",responses_notice_other:"{n} responses have already been submitted for this poll, so be careful about editing it. If you need to make any significant changes, you may want to consider resetting the data or duplicating this poll instead.",response