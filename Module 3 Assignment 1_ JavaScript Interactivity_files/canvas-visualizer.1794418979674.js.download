ols-divider-dotted {\n    border-top: 2px dotted;\n}\n\nhr.panorama-design-tools-divider-solid {\n    border-top: 2px solid;\n}\n\nhr.panorama-design-tools-divider-double {\n    border-top: 3px double;\n}\n\n.panorama-design-tools-breadcrumb {\n    padding: 16px 16px 0px 16px;\n    display: flex;\n    align-items: center;\n    overflow: hidden;\n}\n\n.panorama-design-tools-breadcrumb a {\n    text-decoration: none;\n    font-size: 16px;\n    line-height: 1.5;\n    padding: 0 10px 0 25px;\n    background: #c9e5eb;\n    position: relative;\n    color: black;\n    text-transform: lowercase;\n}\n\n.panorama-design-tools-breadcrumb a:first-letter {\n    text-transform: uppercase;\n}\n\n.panorama-design-tools-breadcrumb a:first-child {\n    padding-left: 46px;\n    border-radius: 5px 0 0 5px;\n    display: none;\n}\n\n.panorama-design-tools-breadcrumb a:first-child:before {\n    left: 14px;\n}\n\n.panorama-design-tools-breadcrumb a.active,\n.panorama-design-tools-breadcrumb a:hover {\n    background: #0b6f85;\n    color: white;\n}\n\n.panorama-design-tools-breadcrumb a.active:after,\n.panorama-design-tools-breadcrumb a:hover:after {\n    background: #0b6f85;\n}\n\n.panorama-design-tools-breadcrumb a:after {\n    content: '';\n    position: absolute;\n    top: 0;\n    right: -18px;\n    width: 36px;\n    height: 36px;\n    transform: scale(0.707) rotate(45deg);\n    z-index: 1;\n    background: #c9e5eb;\n    /* box-shadow: 2px -2px 0 2px rgba(0, 0, 0, 0.4),\n        3px -3px 0 2px rgba(255, 255, 255, 0.1); */\n    border-radius: 0 5px 0 50px;\n}\n\n.panorama-design-tools-tooltip:hover .panorama-design-tools-tooltip-text {\n    visibility: visible !important;\n    opacity: 1 !important;\n}\n\n.panorama-design-tools-tooltip:focus-visible\n    .panorama-design-tools-tooltip-text {\n    visibility: visible !important;\n    opacity: 1 !important;\n}\n\n.panorama-table-of-contents-header {\n    box-shadow: 1px 1px 3px lightgray;\n}\n\n.panorama-table-of-contents-list {\n    box-shadow: 1px 1px 3px lightgray;\n}\n\n.panorama-design-tools-expander div.accordian-button:before {\n    content: url(${d});\n    float: right;\n}\n\n.panorama-design-tools-expander div.accordian-button.is-open:before {\n    content: url(${D});\n    float: right;\n}\n\n.panorama-design-tools-expander div.accordian-button:focus-visible {\n    outline: 2px solid #0b6f85 !important;\n    outline-offset: 5px;\n}\n\n.panorama-design-tools-expander .expander-content {\n    overflow: hidden;\n}\n\n.panorama-design-tools-visual-cue {\n    display: flex;\n}\n\n.panorama-callout {\n    position: relative;\n}\n\n.rounded-callout {\n    border-radius: 10px;\n}\n\n.panorama-callout .panorama-callout-accent {\n    z-index: 10;\n    position: absolute;\n    top: 0;\n    left: 0;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n.rounded-accent {\n    border-radius: 10px 0 0 10px;\n}\n\n.panorama-callout .panorama-callout-info-icon {\n    border-radius: 50%;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n.video-js .vjs-picture-in-picture-control {\n    display: none;\n}\n\n.panorama-design-tools-highlight-text {\n    width: fit-content;\n}\n\n.panorama-ai-summary-prompt {\n    background-color: #f6fafb;\n    font-size: 13px;\n    line-height: 1.6;\n    border-radius: 7px;\n    border: 1px solid #e5f3f5;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 10px;\n    margin-bottom: 10px;\n}\n\n.back-container {\n    display: flex;\n    align-items: center;\n    font-size: 14px;\n    line-height: 1.5;\n    font-weight: 400;\n    justify-content: space-between;\n    cursor: pointer;\n}\n\n.design-tools-error-loading-summary-container,\n.design-tools-loading-summary-container {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n}\n\n.design-tools-error-loading-summary-container {\n    height: 300px;\n}\n\n.design-tools-loading-summary-title {\n    font-weight: 600;\n    font-size: 20px;\n    line-height: 1.4;\n    margin-bottom: 20px;\n    color: black;\n}\n\n.design-tools-loading-description-title {\n    font-weight: 400;\n    font-size: 15px;\n    line-height: 1.5;\n    margin-bottom: 20px;\n    color: black;\n    padding: 0% 18%;\n    text-align: center;\n}\n\n.designs-container {\n    overflow: auto;\n    width: 96%;\n    border: 2px solid #989898;\n    border-radius: 3px;\n    padding: 10px;\n    margin-top: 20px;\n}\n\n.buttons-container {\n    margin-top: 10px;\n    display: flex;\n    justify-content: end;\n}\n\n.image-padding-grid {\n    max-width: 300px;\n    padding-top: 10px;\n}\n\n.image-padding-item {\n    border: 1px solid #d0d0d0;\n    border-radius: 4px;\n    display: flex;\n    align-items: center;\n    /* padding-left: 8px; */\n}\n\n.image-padding-item.MuiBox-root {\n    gap: 0px;\n}\n\n.image-padding-item svg {\n    padding: 0px 8px;\n}\n\n.image-padding-item .MuiBox-root {\n    flex: 1;\n}\n.image-padding-item .MuiBox-root .MuiInputBase-root {\n    width: 100%;\n}\n\n.padding-symmetry-item {\n    display: flex;\n    align-items: center;\n}\n\n.padding-symmetry-button {\n    width: min-content;\n    display: flex;\n    align-items: center;\n    border: 0px;\n    background-color: transparent;\n}\n\n.padding-symmetry-button svg {\n    border-radius: 4px;\n    padding: 5px;\n    border: 1px solid transparent;\n}\n\n.padding-symmetry-button:hover svg {\n    background-color: #ececec;\n}\n.padding-symmetry-button svg:focus-visible {\n    border: 1px solid #0b6f85;\n    outline: none;\n}\n\n.padding-symmetry-button:focus-visible {\n    outline: none;\n\n    background-color: transparent;\n}\n.padding-symmetry-button:focus-visible svg {\n    border: 1px solid #0b6f85;\n    background-color: transparent;\n    outline: none;\n}\n\n#imagePaddingTop,\n#imagePaddingRight,\n#imagePaddingBottom,\n#imagePaddingLeft,\n#imagePaddingX,\n#imagePaddingY {\n    margin-bottom: 0px;\n    padding-right: 0px;\n    border: 0px;\n    box-shadow: none;\n    text-overflow: ellipsis;\n}\n#DesignToolsContainerBody {\n    input[type='number']::-webkit-inner-spin-button,\n    input[type='number']::-webkit-outer-spin-button {\n        -webkit-appearance: none;\n        margin: 0;\n    }\n}\n\n.image-padding-grid .MuiButtonBase-root span {\n    padding: 5px;\n}\n\n.panorama-ai-generated-content {\n    display: none;\n}\n\n/* new themes tab styles */\n.design-tools-themes-container {\n    padding: 30px 15px 10px;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    height: calc(100% - 40px);\n}\n\n.design-tools-themes-tab-container {\n    display: flex;\n    justify-content: space-between;\n}\n\n.design-tools-custom-themes-name-container {\n    width: calc(100% - 180px);\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.design-tools-themes-tag-container {\n    border-radius: 4px;\n    align-self: center;\n    height: 28px;\n    font-size: 15px;\n    width: 105px;\n    text-align: center;\n    line-height: 28px;\n}\n\n#themesSearchBar:autofill {\n    background-color: transparent !important;\n}\n\n.design-tools-empty-themes-container {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    height: max(280px, 100%);\n    gap: 25px;\n}\n\n.design-tools-empty-themes {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 20px;\n}\n\n.design-tools-icons-container {\n    border-radius: 8px;\n    padding: 6px;\n    transition: all 0.2s;\n    height: 36px;\n    box-sizing: border-box;\n    margin-bottom: 5px;\n}\n\n.design-tools-icons-container.selected {\n    background-color: #51515133 !important;\n}\n\n.design-tools-icons-container:hover {\n    background-color: #5151511a;\n}\n\n.design-tools-icons-container.selected > img {\n    filter: brightness(0.6);\n}\n\n.design-tools-icons-container:hover > img {\n    filter: brightness(0.6);\n}\n\n.design-tools-icon-tab-label {\n    color: #5f468e;\n    text-transform: capitalize;\n}\n\n.design-tools-icon-tab-label.selected {\n    color: #42296e;\n}\n\n.design-tools-sort-item-container {\n    display: flex;\n    gap: 8px;\n    font-size: 13px;\n    line-height: 21px;\n    cursor: pointer;\n    font-weight: 600;\n    padding: 0;\n    border: none;\n    background: none;\n    color: inherit;\n    font-family: inherit;\n    text-align: left;\n    align-items: center;\n}\n\n.design-tools-sort-item-container:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 3px;\n    border-radius: 0.5px;\n}\n\n.design-tools-sort-item-arrow {\n    display: flex;\n    align-items: center;\n    opacity: 0;\n    transition: opacity 0.15s ease-in-out;\n}\n\n.design-tools-sort-item-arrow svg {\n    fill: #525252;\n}\n\n.design-tools-sort-item-active .design-tools-sort-item-arrow,\n.design-tools-sort-item-container:hover .design-tools-sort-item-arrow,\n.design-tools-sort-item-container:focus-visible .design-tools-sort-item-arrow {\n    opacity: 1;\n}\n\n.design-tools-preview-header-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 0px 5px 10px;\n    font-weight: 600;\n    position: relative;\n    height: 40px;\n    container-type: size;\n    flex-shrink: 0;\n}\n\n.design-tools-preview-back-button {\n    position: absolute;\n    left: 0px;\n}\n\n.design-tools-preview-header {\n    margin: 0;\n    font-size: inherit;\n    font-weight: inherit;\n}\n\n@container (width < 380px) {\n    .design-tools-preview-back-button {\n        position: static;\n    }\n\n    .design-tools-preview-header {\n        margin: auto;\n        text-align: center;\n    }\n\n    .design-tools-preview-element-image {\n        height: 70px;\n    }\n}\n\n@container (width < 200px) {\n    .design-tools-preview-element-image {\n        height: 70px;\n    }\n}\n\n.publish-options-container {\n    display: flex;\n    flex-wrap: wrap;\n    min-width: 160px;\n    flex: 1 1 0%;\n    column-gap: 5px;\n}\n\n.MuiRadio-root.Mui-focusVisible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 2px;\n}\n\n.drag-handle-container:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 2px;\n}\n\n/* customized datepicker */\n\n.react-datepicker {\n    border-radius: 12px;\n    box-shadow: 0px 0px 6px 0px #2320201a;\n    font-family: InterMedium, Roboto, Segoe UI, Oxygen, Ubuntu, Cantarell,\n        Fira Sans, Droid Sans, Helvetica Neue, sans-serif;\n}\n\n.month-picker-container {\n    height: 33px;\n}\n\n.month-picker-container input:focus-visible {\n    outline: 2px solid #0b6f85;\n    outline-offset: 2px;\n}\n\n.month-picker-icon-container {\n    position: relative;\n    pointer-events: none;\n    width: 100%;\n    height: 100%;\n    margin-top: -33px;\n}\n\n.month-picker-icon {\n    background-repeat: no-repeat;\n    background-size: cover;\n    background-image: url(${T});\n    position: absolute;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    margin-top: auto;\n    margin-bottom: auto;\n    width: 22px;\n    height: 22px;\n    margin-right: 5px;\n}\n\n.react-datepicker__input-container input {\n    height: 34px;\n    cursor: pointer;\n    border: 1px solid #c9bdbd;\n    border-radius: 4px;\n    font-family: InterMedium, Roboto, Segoe UI, Oxygen, Ubuntu, Cantarell,\n        Fira Sans, Droid Sans, Helvetica Neue, sans-serif;\n    padding: 10px;\n    font-size: 15px;\n    line-height: 1.5;\n    width: 165px;\n    box-sizing: border-box;\n}\n\n.react-datepicker__input-container input:hover {\n    border: 1px solid black;\n}\n\n.react-datepicker__input-container input:focus-visible {\n    border: 2px solid #0b6f85;\n    outline: none;\n}\n\n.react-datepicker-customize {\n    border-radius: 5px;\n    border: none;\n    box-shadow: 0px 0px 4px 0px #00000040;\n    font-family: InterMedium, Roboto, Segoe UI, Oxygen, Ubuntu, Cantarell,\n        Fira Sans, Droid Sans, Helvetica Neue, sans-serif;\n    padding: 5px 10px;\n}\n\n.react-datepicker__navigation--next {\n    right: 0;\n    width: 8px;\n    height: 16px;\n    border: none;\n    background-repeat: no-repeat;\n    background-size: contain;\n    background-image: url(${A});\n}\n\n.react-datepicker__navigation--previous {\n    left: 0;\n    width: 8px;\n    height: 16px;\n    border: none;\n    background-repeat: no-repeat;\n    background-size: contain;\n    background-image: url(${j});\n}\n\n.react-datepicker__navigation:focus-visible {\n    outline-color: #0b6f85;\n    outline-offset: 2px;\n}\n\n.react-datepicker__header {\n    background-color: transparent;\n    border-bottom: 0;\n}\n\n.react-datepicker__current-month {\n    font-size: 12px;\n    padding-bottom: 10px;\n    line-height: 1.6;\n}\n\n.react-datepicker__month {\n    margin-bottom: 2px;\n}\n\n.react-datepicker__day {\n    color: #2b2f32;\n    display: inline-block;\n    width: 1.7rem;\n    line-height: 1.7rem;\n    text-align: center;\n    margin: 2px;\n}\n\n.react-datepicker__day--outside-month {\n    color: #8e8c9a;\n}\n\n.react-datepicker__day--disabled {\n    color: #8e8c9a;\n    cursor: default;\n}\n\n.react-datepicker__day.react-datepicker__day--disabled:hover {\n    background-color: transparent;\n}\n\n.react-datepicker__day-name {\n    color: #4c4c4c;\n    margin: 2px;\n}\n\n.react-datepicker__day--selected {\n    border-radius: 20px;\n    background-color: #42296e;\n    color: #fff !important;\n}\n\n.react-datepicker__day--selected:hover {\n    background-color: #42296e !important;\n    color: #fff !important;\n}\n\n.react-datepicker__day:hover,\n.react-datepicker__day--keyboard-selected {\n    border-radius: 20px;\n    background-color: #f0f0f0;\n}\n\n.react-datepicker__day:focus-visible {\n    outline-color: #0b6f85;\n    outline-offset: 3px;\n    border-radius: 20px;\n}\n\n@container report (max-width: 525px) {\n    .react-datepicker__month-text {\n        margin: 5px !important;\n    }\n}\n\n@contai