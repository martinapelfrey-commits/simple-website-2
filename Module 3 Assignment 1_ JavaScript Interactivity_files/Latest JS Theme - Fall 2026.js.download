//////////////////////////////////////////
////  HTML LECTURE PRESENTATION FIX  ////
/////////////////////////////////////////
document.addEventListener('DOMContentLoaded', function() {
    Array.prototype.slice.apply(document.getElementsByTagName('iframe')).forEach(function(iframe) {
        if ((iframe.src || '').indexOf('canvas-user-content') < 0) return;
        if ((iframe.src || '').indexOf('index.html') < 0) return;
        if ((iframe.src || '').indexOf('download=1') < 0) return;
        if ((iframe.src || '').indexOf('inline=1') < 0) return;
 
        iframe.sandbox = (iframe.sandbox || '') + ' allow-scripts';
        iframe.src = iframe.src;
    });
});
//////////////////////////////////////////////
////  END HTML LECTURE PRESENTATION FIX  ////
/////////////////////////////////////////////

