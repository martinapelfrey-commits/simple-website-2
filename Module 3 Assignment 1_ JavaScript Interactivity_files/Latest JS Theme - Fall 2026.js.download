////////////////////////////////////////////////////
// SYLLABUS IFRAME COURSE NUMBER HELPER           //
////////////////////////////////////////////////////
// This helper allows passing the current course  //
// number to the syllabus iframe, since Canvas    //
// doesn't support merge trags.                   //
////////////////////////////////////////////////////
(function() {
window.addEventListener('message', function(evt) {
    if (evt.data !== 'course_id_request') return;

    var syllabus_frame = document.querySelector('.syllabus-frame');
    if (!syllabus_frame) return;

    var coursenum_match = document.location.pathname.match(/^\/courses\/(\d+)/);
    if (!coursenum_match) return;

    syllabus_frame.contentWindow.postMessage(
        'course_id_response:' + coursenum_match[1],
        'https://www.indianatech.edu'
    );
});
})();
////////////////////////////////////////////////////
// END SYLLABUS IFRAME COURSE NUMBER HELPER       //
////////////////////////////////////////////////////

////////////////////////////////////////////////////
// IFRAME RESIZER                                 //
////////////////////////////////////////////////////
// This helper allows passing the height of a     //
// child frame back to the parent in order to     //
// make a responsive iframe.                      //
////////////////////////////////////////////////////
window.addEventListener('message', function(evt) {
    if (typeof evt.data !== 'string') return;
    var resize_match = null;
    if (resize_match = evt.data.match(/^resize_child:(\d+)/)) {
        document.querySelector('#content-wrapper iframe').style.height = resize_match[1] + 'px';
    }
});
////////////////////////////////////////////////////
// END IFRAME RESIZER                             //
////////////////////////////////////////////////////

//////////////////////////
////  YUJA PANORAMA  ////
/////////////////////////
(async function() {
    const PANORAMA_SERVER_URL = 'https://panorama-api.yuja.com';
    const panoramaIdentifierKey = 'b100c89f3f5792322bac6e718d99aae81bda4d8e28d13dccf825ceef2d5220b0';
    const PANORAMA_CDN_URL = 'https://cdn-panorama.yuja.com';

    window.PANORAMA_SERVER_URL = PANORAMA_SERVER_URL;
    window.panoramaIdentifierKey = panoramaIdentifierKey;
    window.PANORAMA_CDN_URL = PANORAMA_CDN_URL;

    function loadScript(url) {
        const script = document.createElement('script');
        script.src = url;
        document.head.appendChild(script);
    }

    try {
        const response = await fetch(`${PANORAMA_SERVER_URL}/panorama-visualizer/canvas`, {cache: 'no-store'});
        const scriptUrl = await response.text();
        loadScript(scriptUrl);
    } catch (e) {
        console.error('Failed to load Panorama: ', e);
    }
})();
//////////////////////////////
////  END YUJA PANORAMA  ////
/////////////////////////////

